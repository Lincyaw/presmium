    "pass--sort-code": {
      "id": "pass--sort-code",
      "type": "code",
      "language": "python",
      "value": "def bubble_pass(a):\n    for i in range(len(a) - 1):\n        if a[i] > a[i + 1]:\n            a[i], a[i + 1] = a[i + 1], a[i]\n    return a"
    },
