    "pass--paragraph-1--narration": {
      "id": "pass--paragraph-1--narration",
      "content": [
        {
          "type": "text",
          "text": "冒泡排序每一趟比较相邻的两个数，把大的往后换。先看这五个数。"
        }
      ]
    },
    "pass--paragraph-2--narration": {
      "id": "pass--paragraph-2--narration",
      "content": [
        {
          "type": "text",
          "text": "第一次比较 5 和 2，"
        },
        {
          "id": "cue-pass-1",
          "type": "cue",
          "action": "click",
          "target": {
            "blockId": "pass--stats"
          },
          "parameters": {
            "arg": "compare"
          }
        },
        {
          "type": "text",
          "text": " 比较次数加一。"
        }
      ]
    },
    "pass--paragraph-3--narration": {
      "id": "pass--paragraph-3--narration",
      "content": [
        {
          "type": "text",
          "text": "5 比 2 大，"
        },
        {
          "id": "cue-pass-1-2",
          "type": "cue",
          "action": "spot",
          "target": {
            "blockId": "pass--sort-code"
          },
          "parameters": {
            "lines": "3-4"
          }
        },
        {
          "type": "text",
          "text": " 交换它们。"
        }
      ]
    },
    "pass--paragraph-4--narration": {
      "id": "pass--paragraph-4--narration",
      "content": [
        {
          "type": "text",
          "text": "再比较 5 和 4，"
        },
        {
          "id": "cue-pass-1-3",
          "type": "cue",
          "action": "click",
          "target": {
            "blockId": "pass--stats"
          },
          "parameters": {
            "arg": "compare"
          }
        },
        {
          "type": "text",
          "text": " 又是前面大，再交换。"
        }
      ]
    },
    "pass--paragraph-5--narration": {
      "id": "pass--paragraph-5--narration",
      "content": [
        {
          "type": "text",
          "text": "5 继续往后，越过 1 和 3，"
        },
        {
          "id": "cue-pass-1-4",
          "type": "cue",
          "action": "pause"
        },
        {
          "type": "text",
          "text": " 停在最后，这一趟结束。"
        }
      ]
