  "blocks": {
    "text-1": {
      "id": "text-1",
      "type": "text",
      "content": [
        {
          "id": "paragraph-2",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "本讲需要访问外部站点，故不作为离线核心流程。断网、浏览器策略或提供方限制都可能导致加载失败；文稿仍应保留源地址与可读说明。"
            }
          ]
        },
        {
          "id": "paragraph-3",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "本地音视频、字幕与静态图片见“正文、排版与富内容”。这里不使用 example.com 假媒体地址。"
            }
          ]
        }
      ]
    },
    "youtube-widget": {
      "id": "youtube-widget",
      "type": "component",
      "definitionId": "youtube-widget-definition",
      "parameters": {
        "id": "luoMHjh-XcQ",
        "start": 30,
        "caption": "仓库既有的联网视频样例；内容由外部提供方托管。"
      }
    },
    "text-4": {
      "id": "text-4",
      "type": "text",
      "content": [
        {
          "id": "paragraph-5",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "需要能访问 YouTube，外部视频的可用性与内容可能改变。播放器不是本地文件，也不会因为保存网页就自动离线。"
            }
          ]
        }
      ]
    },
    "plantuml-diagram": {
      "id": "plantuml-diagram",
      "type": "code",
      "language": "plantuml",
      "value": "@startuml\nactor Author\nAuthor -> Document : Save with version\nDocument -> Compiler : Derive snapshot\nCompiler -> Viewer : Publish\n@enduml"
    },
    "text-6": {
      "id": "text-6",
      "type": "text",
      "content": [
        {
          "id": "paragraph-7",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "默认通过 PlantUML 服务生成 SVG。生产部署可以配置自己的渲染服务；网络不可达时无法得到图像，不能把源码通过校验当成渲染成功。"
            }
          ]
        }
      ]
    },
    "remote-video": {
      "id": "remote-video",
      "type": "component",
      "definitionId": "remote-video-definition",
      "parameters": {
        "kind": "video",
        "src": "https://raw.githubusercontent.com/Lincyaw/presmium/main/packages/addon-content/media/clip.webm",
        "controls": true,
        "muted": true,
        "caption": "与本地示例相同的真实仓库视频，经 HTTPS 读取。"
      }
    },
    "remote-audio": {
      "id": "remote-audio",
      "type": "component",
      "definitionId": "remote-audio-definition",
      "parameters": {
        "kind": "audio",
        "src": "https://raw.githubusercontent.com/Lincyaw/presmium/main/packages/addon-content/media/tone.ogg",
        "controls": true,
        "caption": "远端短提示音。播放前调低音量。"
      }
    },
    "remote-image": {
      "id": "remote-image",
      "type": "image",
      "assetId": "remote-image-asset",
      "alt": "仓库中的加载图标，经外部 HTTPS 读取"
    },
    "text-8": {
      "id": "text-8",
      "type": "text",
      "content": [
        {
          "id": "paragraph-9",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "本讲显式关闭构建时远端图片下载。需要离线发布时，可在准备好网络和版权条件后启用发布插件的资源本地化，检查真实下载结果再分发。"
            }
          ]
        },
        {
          "id": "paragraph-10",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "自托管课堂、模型、语音与 Jupyter 服务的端点及凭据由运营者配置，不能硬编码到公开示例。外部失败与能力不足都应保留真实诊断。"
            }
          ]
        }
      ]
    }
  },
