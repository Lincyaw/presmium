  "definitions": {
    "youtube-widget-definition": {
      "id": "youtube-widget-definition",
      "kind": "component",
      "schemaVersion": 1,
      "implementation": {
        "type": "plugin",
        "plugin": "presmium.content",
        "name": "PmYoutube"
      },
      "parameterSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "视频标识",
            "readOnly": true
          },
          "start": {
            "type": "number",
            "title": "开始时间（秒）",
            "minimum": 0
          },
          "width": {
            "type": "number",
            "title": "宽度",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "title": "高度",
            "exclusiveMinimum": 0
          },
          "caption": {
            "type": "string",
            "title": "说明文字"
          }
        },
        "required": [
          "id"
        ]
      },
      "states": [],
      "data": {
        "fallback": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "外部视频：https://www.youtube.com/watch?v=luoMHjh-XcQ，从 30 秒开始。"
                }
              ]
            }
          ]
        }
      }
    },
    "remote-video-definition": {
      "id": "remote-video-definition",
      "kind": "component",
      "schemaVersion": 1,
      "implementation": {
        "type": "plugin",
        "plugin": "presmium.content",
        "name": "PmMedia"
      },
      "parameterSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "title": "媒体类型",
            "enum": [
              "video",
              "audio",
              "animation"
            ],
            "readOnly": true
          },
          "src": {
            "type": "string",
            "title": "媒体来源",
            "readOnly": true
          },
          "caption": {
            "type": "string",
            "title": "说明文字"
          },
          "controls": {
            "type": "boolean",
            "title": "显示播放控件"
          },
          "autoplay": {
            "type": "boolean",
            "title": "自动播放"
          },
          "loop": {
            "type": "boolean",
            "title": "循环播放"
          },
          "muted": {
            "type": "boolean",
            "title": "静音"
          },
          "poster": {
            "type": "string",
            "title": "封面来源",
            "readOnly": true
          },
          "captions": {
            "type": "object",
            "title": "字幕文件",
            "additionalProperties": {
              "type": "string"
            },
            "readOnly": true
          },
          "captionsDefault": {
            "type": "string",
            "title": "默认字幕语言",
            "readOnly": true
          },
          "width": {
            "type": "number",
            "title": "宽度",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "title": "高度",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "kind",
          "src"
        ]
      },
      "states": [],
      "data": {
        "fallback": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "远端视频：https://raw.githubusercontent.com/Lincyaw/presmium/main/packages/addon-content/media/clip.webm"
                }
              ]
            }
          ]
        }
      }
    },
    "remote-audio-definition": {
