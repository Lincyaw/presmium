          "src": {
            "type": "string",
            "title": "媒体来源",
            "readOnly": true
          },
          "caption": {
            "type": "string",
            "title": "说明文字"
          },
          "controls": {
            "type": "boolean",
            "title": "显示播放控件"
          },
          "autoplay": {
            "type": "boolean",
            "title": "自动播放"
          },
          "loop": {
            "type": "boolean",
            "title": "循环播放"
          }
        },
        "required": [
