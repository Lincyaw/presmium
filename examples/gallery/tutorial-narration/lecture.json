  "narrations": {
    "script-intro": {
      "id": "script-intro",
      "content": [
        {
          "type": "text",
          "text": "读音标记让 "
        },
        {
          "type": "pronunciation",
          "display": "SQL",
          "spoken": "sequel"
        },
        {
          "type": "text",
          "text": " 按指定的读法念出来。"
        },
        {
          "id": "add-cue",
          "type": "cue",
          "action": "call",
          "target": {
            "blockId": "production-counter"
          },
          "parameters": {
            "arg": "add"
          }
        },
        {
          "type": "text",
          "text": "动作标记一到，计数器就加一。"
        },
        {
          "id": "pause-cue",
          "type": "cue",
          "action": "pause"
        },
        {
          "type": "text",
          "text": "停顿过后，配音接着往下念。"
        }
      ]
    },
    "timing-script-0": {
      "id": "timing-script-0",
      "content": [
        {
          "type": "text",
          "text": "这一句和动画同时开始，适合讲解正在发生的变化。"
        }
      ]
    },
    "timing-script-1": {
      "id": "timing-script-1",
      "content": [
        {
          "type": "text",
          "text": "这一句等动画结束才开始，适合评论变化的结果。"
        }
      ]
    },
    "start-narration": {
      "id": "start-narration",
      "content": [
        {
          "type": "text",
          "text": "讲授视频由讲稿驱动。讲稿决定念什么、何时触发动作、在哪里停。配音可以用 AI、用录音，也可以静音。"
        }
      ]
    },
    "g-script-narration": {
      "id": "g-script-narration",
      "content": [
        {
          "type": "text",
          "text": "讲稿里可以加三种标记：读音、动作和停顿。每一步还要选，是跟动画一起讲，还是等动画放完再讲。"
        }
      ]
    },
    "g-preview-narration": {
      "id": "g-preview-narration",
      "content": [
        {
          "type": "text",
          "text": "导出之前，先在时间线上把整份讲授看一遍。还没有配音，也可以先做静音版，只放字幕。"
        }
      ]
    },
    "timeline-narration": {
      "id": "timeline-narration",
      "content": [
        {
          "type": "text",
          "text": "时间线把画面、配音和字幕排成三条轨道。点一下某一步就跳过去，拖动播放头可以细调位置。"
        }
      ]
    },
    "silent-narration": {
      "id": "silent-narration",
      "content": [
        {
          "type": "text",
          "text": "静音讲授没有声音，只放字幕。每一步至少停两秒，字幕按时往下走。可以先排好节奏，再配音。"
        }
      ]
    },
    "g-voice-narration": {
      "id": "g-voice-narration",
      "content": [
        {
          "type": "text",
          "text": "声音有三种来源：AI 配音，自己的录音，还有跟配音一起播放的音频片段。"
        }
      ]
    },
    "voices-narration": {
      "id": "voices-narration",
      "content": [
        {
          "type": "text",
          "text": "AI 配音要先填语音服务的密钥。音色可以只用于一步、一页，或整份文稿。播放时缺少的配音会自动生成。"
        }
      ]
    },
    "recording-narration": {
      "id": "recording-narration",
      "content": [
        {
          "type": "text",
          "text": "用自己的声音，就在原音频卡里录音，保存成素材，再采用为这一步的配音。录音还能转写成讲稿。"
        }
      ]
    },
    "media-editing-narration": {
      "id": "media-editing-narration",
      "content": [
        {
          "type": "text",
          "text": "音频片段和配音同时播放。导入本地音频，截取一段，调好延后和音量，原文件不会被改动。"
        }
      ]
    },
    "deliver-narration": {
      "id": "deliver-narration",
      "content": [
        {
          "type": "text",
          "text": "设置好配音或静音，就能导出带字幕的视频。声音、字幕和动作都来自讲稿；改了讲稿，重新配音再导出即可。"
        }
      ]
    }
  },
