              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "Late at night, the teacher's phone lights up. In the class chat, Sam asks: \"How can a bunch of spinning circles draw any shape?\""
                }
              ]
            }
          ]
        }
      }
    },
    "board-shot": {
      "id": "board-shot",
      "kind": "scene",
      "schemaVersion": 1,
      "implementation": {
        "type": "file",
        "path": "scenes/film.ts"
      },
      "parameterSchema": {
        "type": "object",
        "properties": {
          "shot": {
            "type": "string",
            "enum": [
              "question",
              "board",
              "ask",
              "brand"
            ]
          }
        },
        "required": [
          "shot"
        ],
        "additionalProperties": false
      },
      "states": [
        {
          "id": "show"
        }
      ],
      "data": {
        "plugin": "presmium.motion",
        "name": "PmScene",
        "language": "typescript",
        "durations": [
          4363
        ],
        "fallback": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "Last class's blackboard: a square wave, built from sin x, then + sin 3x/3, then + sin 5x/5, drawn three times and erased twice. Drew it three times. Still didn't click."
                }
              ]
            }
          ]
        }
      }
    },
    "ask-shot": {
      "id": "ask-shot",
      "kind": "scene",
      "schemaVersion": 1,
      "implementation": {
        "type": "file",
        "path": "scenes/film.ts"
      },
      "parameterSchema": {
        "type": "object",
        "properties": {
          "shot": {
