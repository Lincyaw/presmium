              "board",
              "ask",
              "brand"
            ]
          }
        },
        "required": [
          "shot"
        ],
        "additionalProperties": false
      },
      "states": [
        {
          "id": "studio"
        },
        {
          "id": "lesson"
        },
        {
          "id": "website"
        },
        {
          "id": "video"
        }
      ],
      "data": {
        "plugin": "presmium.motion",
        "name": "PmScene",
        "language": "typescript",
        "durations": [
          16364,
          11999,
          4364,
          8727
        ],
        "fallback": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "That night, in Presmium, the teacher selects the paragraph on the corners of the note and leaves a comment: \"Animate this: draw the note with 1, 2, 4 … 64 circles.\" The AI Assistant applies it, and the page comes back with the turning circles, drawing the note with 2, 4, then 8 circles."
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "Next morning in class, the same figure is on the screen, at 8 circles. Each click is one step: 16, 32, then 64 circles, and the curve closes in on the note while the error falls below half a percent. \"Oh, I see!\""
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "After class, the same figure, at 64 circles, is on the course website."
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "And in the lesson video in the class chat: missed a step? Drag it back. Sam replies: \"Got it! Each circle adds a finer detail, so more circles get closer to the shape.\""
                }
              ]
            }
          ]
        }
      }
    },
