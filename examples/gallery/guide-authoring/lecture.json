  "narrations": {
    "start-narration": {
      "id": "start-narration",
      "content": [
        {
          "type": "text",
          "text": "用每人三十元的预算，练习把一份讲义改成自己的讲课方案。"
        }
      ]
    },
    "budget-prices": {
      "id": "budget-prices",
      "content": [
        {
          "type": "text",
          "text": "先看三项价格：主食十二元，配菜八元，饮品五元。价格表里的 "
        },
        {
          "type": "pronunciation",
          "display": "¥",
          "spoken": "人民币"
        },
        {
          "type": "text",
          "text": " 是货币标记。"
        },
        {
          "id": "budget-pause",
          "type": "cue",
          "action": "pause",
          "target": {
            "blockId": "budget-table"
          }
        },
        {
          "type": "text",
          "text": "现在自己估算一下。"
        }
      ]
    },
    "budget-condition": {
      "id": "budget-condition",
      "content": [
        {
          "type": "text",
          "text": "我们先按每人每样各买一份计算。"
        }
      ]
    },
    "budget-result": {
      "id": "budget-result",
      "content": [
        {
          "type": "text",
          "text": "三项合计二十五元，在三十元预算内，还剩五元。"
        }
      ]
    }
  },
