      }
    },
    "delivery": {
      "id": "delivery",
      "title": "保存你的方案，再进入放映或输出",
      "level": 2,
      "children": [
        "delivery-purpose",
        "delivery-actions",
        "delivery-version",
        "delivery-next"
      ],
      "stepOrder": [
        "delivery-step"
      ],
