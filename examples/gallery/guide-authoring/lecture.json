{
  "schemaVersion": 1,
  "id": "presmium-guide-authoring",
  "metadata": {
    "title": "功能导览 09：动手编辑一份讲义",
    "lang": "zh-CN",
    "description": "用一份午餐预算小讲义练习页面复制、原生编辑、每步讲稿、播放时机、保存与输出。",
    "plugins": [
      "@lincyaw/addon-lecture"
    ],
    "renderers": {
      "web": {},
      "slides": {},
      "notebook": {},
      "lecture": {}
    }
  },
  "sectionOrder": [
    "start",
    "budget",
    "copy",
    "scripts",
    "timing",
    "comments",
    "delivery"
  ],
  "sections": {
    "start": {
      "id": "start",
