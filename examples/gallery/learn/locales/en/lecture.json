  "narrations": {
    "question-step-narration": {
      "id": "question-step-narration",
      "content": [
        {
          "type": "text",
          "text": "A circle has no corners. Yet chain turning circles end to end, and they draw a shape with sharp corners. Let's see how many circles it takes."
        }
      ]
    },
    "one-circle-step-narration": {
      "id": "one-circle-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Start with one circle. It turns once, and the pen draws a circle, with no corners at all."
        }
      ]
    },
    "two-circles-step-narration": {
      "id": "two-circles-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Put a smaller circle on its rim, turning twice the other way. The pen's path bends, and three rounded corners appear."
        }
      ]
    },
    "fit-1-step-narration": {
      "id": "fit-1-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Now take a musical note. With only the largest circle, all we get is a circle, about sixty-four percent off."
        }
      ]
    },
    "fit-2-step-narration": {
      "id": "fit-2-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Two circles squeeze the circle into a tilted ellipse, already leaning like the note."
        }
      ]
    },
    "fit-4-step-narration": {
      "id": "fit-4-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Four circles begin to separate the head from the flag."
        }
      ]
    },
    "fit-8-step-narration": {
      "id": "fit-8-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Eight circles, and it is clearly a note. The error is down to about eight percent."
        }
      ]
    },
    "fit-16-step-narration": {
      "id": "fit-16-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Sixteen circles straighten the stem. Look at the corners: the curve overshoots and swings back."
        }
      ]
    },
    "fit-32-step-narration": {
      "id": "fit-32-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Thirty-two circles, about one percent off, and the ripples at the corners get shorter."
        }
      ]
    },
    "fit-64-step-narration": {
      "id": "fit-64-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Sixty-four circles, and the curve almost lies on the outline, less than half a percent off. The more circles, the closer the shape."
        }
      ]
    },
    "star-2-step-narration": {
      "id": "star-2-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Now a star. Guess how many circles it needs. With just two, it already has five corners."
        }
      ]
    },
    "star-4-step-narration": {
      "id": "star-4-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Four circles sharpen the five points and straighten the edges a little."
        }
      ]
    },
    "star-16-step-narration": {
      "id": "star-16-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Sixteen circles, and the edges are straight; only the corners are still a little round."
        }
      ]
    },
    "star-64-step-narration": {
      "id": "star-64-step-narration",
      "content": [
        {
          "type": "text",
          "text": "Sixty-four circles, and you can hardly tell it from the star. Pick another shape and try it yourself."
        }
      ]
    }
  },
