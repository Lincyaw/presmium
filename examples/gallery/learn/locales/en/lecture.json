    "next-body": {
      "id": "next-body",
      "type": "text",
      "content": [
        {
          "id": "next-try",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "A star looks the same after a fifth of a turn, so only circles whose n leaves a remainder of 1 when divided by 5 are non-zero, and two circles already give five corners. Change the shape in epicycles.ts, predict how many circles it needs, then check."
            }
          ]
        },
        {
