  "narrations": {
    "question-step-narration": {
      "id": "question-step-narration",
      "content": [
        {
          "type": "text",
          "text": "圆没有尖角。可是把转动的圆一个接一个串起来，就能画出带尖角的形状。我们来看看要几个圆。"
        }
      ]
    },
    "one-circle-step-narration": {
      "id": "one-circle-step-narration",
      "content": [
        {
          "type": "text",
          "text": "先看一个圆。它转一圈，笔就画出一个圆，不会有任何角。"
        }
      ]
    },
    "two-circles-step-narration": {
      "id": "two-circles-step-narration",
      "content": [
        {
          "type": "text",
          "text": "在它的边上再放一个小圆，反向转两圈。笔的轨迹被掰弯，出现了三个圆角。"
        }
      ]
    },
    "fit-1-step-narration": {
      "id": "fit-1-step-narration",
      "content": [
        {
          "type": "text",
          "text": "现在换成音符。只用最大的一个圆，画出的只是一个圆，误差约百分之六十四。"
        }
      ]
    },
    "fit-2-step-narration": {
      "id": "fit-2-step-narration",
      "content": [
        {
          "type": "text",
          "text": "两个圆，圆被压成一个斜着的椭圆，方向已经和音符一致。"
        }
      ]
    },
    "fit-4-step-narration": {
      "id": "fit-4-step-narration",
      "content": [
        {
          "type": "text",
          "text": "四个圆，开始分出符头和符尾。"
        }
      ]
    },
    "fit-8-step-narration": {
      "id": "fit-8-step-narration",
      "content": [
        {
          "type": "text",
          "text": "八个圆，已经能认出是一个音符，误差降到约百分之八。"
        }
      ]
    },
    "fit-16-step-narration": {
      "id": "fit-16-step-narration",
      "content": [
        {
          "type": "text",
          "text": "十六个圆，符杆变直了。注意尖角附近，曲线冲过头又绕回来。"
        }
      ]
    },
    "fit-32-step-narration": {
      "id": "fit-32-step-narration",
      "content": [
        {
          "type": "text",
          "text": "三十二个圆，误差约百分之一，尖角处的波纹变短。"
        }
      ]
    },
    "fit-64-step-narration": {
      "id": "fit-64-step-narration",
      "content": [
        {
          "type": "text",
          "text": "六十四个圆，曲线几乎贴着轮廓，误差不到百分之零点五。圆越多，越接近原来的形状。"
        }
      ]
    },
    "star-2-step-narration": {
      "id": "star-2-step-narration",
      "content": [
        {
          "type": "text",
          "text": "换成五角星。先猜要几个圆。只用两个，就已经有了五个角。"
        }
      ]
    },
    "star-4-step-narration": {
      "id": "star-4-step-narration",
      "content": [
        {
          "type": "text",
          "text": "四个圆，五个尖角变得更尖，边也变直了一些。"
        }
      ]
    },
    "star-16-step-narration": {
      "id": "star-16-step-narration",
      "content": [
        {
          "type": "text",
          "text": "十六个圆，边已经是直的，只在尖角处还有一点圆。"
        }
      ]
    },
    "star-64-step-narration": {
      "id": "star-64-step-narration",
      "content": [
        {
          "type": "text",
          "text": "六十四个圆，和原来的五角星几乎分不出来。换一个形状，自己试试。"
        }
      ]
    }
  },
