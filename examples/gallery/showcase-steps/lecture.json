    "text-11": {
      "id": "text-11",
      "type": "text",
      "content": [
        {
          "id": "ss-4",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "下面的计数器是一个可操作的组件：每点击一次“加一次”，计数加一。讲稿也可以在讲到指定位置时自动触发同一个动作。"
            }
          ]
        }
      ],
      "only": [
        "web",
        "notebook"
      ]
