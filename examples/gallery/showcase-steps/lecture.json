      }
    },
    "guide-cursor": {
      "id": "guide-cursor",
      "type": "component",
      "definitionId": "guide-cursor-definition",
      "parameters": {
        "path": [
          {
            "to": "#feature-action-add",
            "action": "move",
            "at": 0
          },
          {
            "to": "#feature-action-add",
            "action": "hover",
            "at": 1
          },
          {
            "to": "#feature-action-add",
            "action": "click",
            "at": 2
          }
