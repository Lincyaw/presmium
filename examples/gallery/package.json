{
  "name": "presmium-gallery",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "presmium serve .",
    "build": "node tools/build.mjs",
    "check": "node tools/course.mjs check",
    "ir": "node tools/course.mjs ir",
    "source": "node tools/package-source.mjs",
    "score": "node promo/tools/score.mjs",
    "lesson-film": "presmium-lecture export learn --out public/presmium-lesson.webm --size 1280x720 --fps 24",
    "film": "presmium-lecture export promo --out public/presmium-60s.webm --size 1920x1080 --fps 30",
    "check:site": "presmium check promo && presmium check learn"
  },
  "dependencies": {
    "@lincyaw/addon-assistant": "workspace:*",
    "@lincyaw/addon-classroom": "workspace:*",
    "@lincyaw/addon-code": "workspace:*",
    "@lincyaw/addon-content": "workspace:*",
    "@lincyaw/addon-exec": "workspace:*",
    "@lincyaw/addon-exec-jupyter": "workspace:*",
    "@lincyaw/addon-exec-local": "workspace:*",
    "@lincyaw/addon-exec-wasi": "workspace:*",
    "@lincyaw/addon-exec-webgpu": "workspace:*",
    "@lincyaw/addon-guide": "workspace:*",
    "@lincyaw/addon-lecture": "workspace:*",
    "@lincyaw/addon-motion": "workspace:*",
    "@lincyaw/addon-publish": "workspace:*",
    "@lincyaw/addon-session": "workspace:*",
    "@lincyaw/addon-speech": "workspace:*",
    "@lincyaw/addon-stage": "workspace:*",
    "@lincyaw/cli": "workspace:*",
    "@lincyaw/compiler": "workspace:*",
    "@lincyaw/design": "workspace:*",
    "@lincyaw/host": "workspace:*",
    "@lincyaw/kernel": "workspace:*",
    "@lincyaw/presmium": "workspace:*",
    "@lincyaw/render-notebook": "workspace:*",
    "@lincyaw/render-slides": "workspace:*",
    "@lincyaw/viewer": "workspace:*",
    "@lincyaw/web": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "2.9.0"
  },
  "presmium": {
    "preview": {
      "restartable": true
    }
  },
  "description": "Presmium gallery: courses, feature guides, Fourier lesson and product film"
}
