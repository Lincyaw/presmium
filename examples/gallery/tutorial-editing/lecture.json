  "blocks": {
    "start-goal": {
      "id": "start-goal",
      "type": "text",
      "content": [
        {
          "id": "te-1",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "在工作台中打开本文稿，按后续页面的顺序依次操作，将“午餐预算”改为自己的方案。全程无需配置模型或语音服务。"
            }
          ]
        }
      ]
    },
    "budget-question": {
      "id": "budget-question",
      "type": "text",
      "content": [
        {
          "id": "budget-question-p1",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "每人预算 30 元。主食、配菜与饮品各选一份，如何检查是否超支？"
            }
          ]
        }
      ]
    },
    "budget-table": {
      "id": "budget-table",
      "type": "text",
      "content": [
        {
          "id": "budget-price-table",
          "type": "table",
          "headerRows": 1,
          "columnWidths": [
            180,
            100
          ],
          "children": [
            {
              "id": "budget-row-0",
              "type": "tableRow",
              "children": [
                {
                  "id": "budget-cell-0-0",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "项目"
                    }
                  ]
                },
                {
                  "id": "budget-cell-0-1",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "价格（¥）"
                    }
                  ]
                }
              ]
            },
            {
              "id": "budget-row-1",
              "type": "tableRow",
              "children": [
                {
                  "id": "budget-cell-1-0",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "主食"
                    }
                  ]
                },
                {
                  "id": "budget-cell-1-1",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "12"
                    }
                  ]
                }
              ]
            },
            {
              "id": "budget-row-2",
              "type": "tableRow",
              "children": [
                {
                  "id": "budget-cell-2-0",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "配菜"
                    }
                  ]
                },
                {
                  "id": "budget-cell-2-1",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "8"
                    }
                  ]
                }
              ]
            },
            {
              "id": "budget-row-3",
              "type": "tableRow",
              "children": [
                {
                  "id": "budget-cell-3-0",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "饮品"
                    }
                  ]
                },
                {
                  "id": "budget-cell-3-1",
                  "type": "tableCell",
                  "children": [
                    {
                      "type": "text",
                      "text": "5"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "budget-method": {
      "id": "budget-method",
      "type": "text",
      "content": [
        {
          "id": "budget-method-list",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "budget-method-item1",
              "type": "listItem",
              "children": [
                {
                  "id": "budget-method-line1",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "先估算：12 + 8 约为 20，再加 5，应小于 30。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "budget-method-item2",
              "type": "listItem",
              "children": [
                {
                  "id": "budget-method-line2",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "再精算：12 + 8 + 5 = 25。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "budget-method-item3",
              "type": "listItem",
              "children": [
                {
                  "id": "budget-method-line3",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "核对余额：30 − 25 = 5，预算内剩余 5 元。"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "budget-conclusion": {
      "id": "budget-conclusion",
      "type": "text",
      "content": [
        {
          "id": "budget-conclusion-p1",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "结论：合计 25 元，剩余 5 元。"
            }
          ]
        }
      ]
    },
    "budget-details": {
      "id": "budget-details",
      "type": "container",
      "layout": "stack",
      "children": [
        "budget-table",
        "budget-method"
      ],
      "properties": {
        "title": "价格与计算过程"
      }
    },
    "copy-actions": {
      "id": "copy-actions",
      "type": "text",
      "content": [
        {
          "id": "te-2",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "te-3",
              "type": "listItem",
              "children": [
                {
                  "id": "te-4",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "在页面栏打开“练习材料：午餐预算”的更多菜单，选择“复制页面”。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "te-5",
              "type": "listItem",
              "children": [
                {
                  "id": "te-6",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "点击“撤消”，副本被移除；再点击“恢复”，副本重新出现。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "te-7",
              "type": "listItem",
              "children": [
                {
                  "id": "te-8",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "将副本重命名为“午餐方案 B”，并在表格中将配菜价格由 8 改为 10。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "te-9",
              "type": "listItem",
              "children": [
                {
                  "id": "te-10",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "将计算过程与结论改为：12 + 10 + 5 = 27，余额 3 元。"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "copy-boundary": {
      "id": "copy-boundary",
      "type": "text",
      "content": [
        {
          "id": "te-11",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "副本拥有独立的正文、步骤与讲稿；图片与组件定义仍与原页共享。"
            }
          ]
        }
      ]
    },
    "scripts-actions": {
      "id": "scripts-actions",
      "type": "text",
      "content": [
        {
          "id": "te-12",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "te-13",
              "type": "listItem",
              "children": [
                {
                  "id": "te-14",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "选中“午餐方案 B”，点击工具栏中的“字幕”，打开讲稿栏。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "te-15",
              "type": "listItem",
              "children": [
                {
                  "id": "te-16",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "将第一步讲稿中的“配菜八元”改为“配菜十元”。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "te-17",
              "type": "listItem",
              "children": [
                {
                  "id": "te-18",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "点击“下一步”，将合计与余额分别改为二十七元、三元。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "te-19",
              "type": "listItem",
              "children": [
                {
                  "id": "te-20",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "刷新页面，确认正文与讲稿均已保存。"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "scripts-scope": {
      "id": "scripts-scope",
      "type": "text",
      "content": [
        {
          "id": "te-21",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "每一步拥有独立的讲稿，同时用作配音文本与字幕。含动画的页面也可在动画卡片上直接编辑讲稿。"
            }
          ]
        }
      ]
    },
    "timing-actions": {
      "id": "timing-actions",
      "type": "text",
      "content": [
        {
          "id": "te-22",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "te-23",
              "type": "listItem",
              "children": [
                {
                  "id": "te-24",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "在讲稿栏中找到“播放时机”：本页继承的最短停留为 1200 毫秒，结束停顿为 250 毫秒。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "te-25",
              "type": "listItem",
              "children": [
                {
                  "id": "te-26",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "点击“统一本步时机”，将“配音开始”设为“动画后”，最短停留设为 1800 毫秒。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "te-27",
              "type": "listItem",
              "children": [
                {
                  "id": "te-28",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "点击“使用继承的时机”，本步恢复为页面设置。"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "comments-actions": {
      "id": "comments-actions",
      "type": "text",
      "content": [
        {
          "id": "te-29",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "te-30",
              "type": "listItem",
              "children": [
                {
                  "id": "te-31",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "选中结论中的“3 元”，点击“新建批注”，输入：能否再增加一份配菜？"
                    }
                  ]
                }
              ]
            },
            {
              "id": "te-32",
              "type": "listItem",
              "children": [
                {
                  "id": "te-33",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "在正文中输入一句话，再依次使用“撤消”与“恢复”。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "te-34",
              "type": "listItem",
              "children": [
                {
                  "id": "te-35",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "打开“版本历史”，查看已保存的各个版本。"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "comments-agent": {
      "id": "comments-agent",
      "type": "text",
      "content": [
        {
          "id": "te-36",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "多条批注可一并“发送给 AI”进行修改；未配置模型时，编辑、批注与保存均可正常使用。"
            }
          ]
        }
      ]
    },
    "delivery-purpose": {
      "id": "delivery-purpose",
      "type": "text",
      "content": [
        {
          "id": "te-42",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "放映和导出使用最近一次保存的版本。讲稿与配音的操作见“讲稿与配音”教程。"
            }
          ]
        }
      ]
    },
    "delivery-actions": {
      "id": "delivery-actions",
      "type": "text",
      "content": [
        {
          "id": "te-37",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "te-38",
              "type": "listItem",
              "children": [
                {
                  "id": "te-39",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "点击“放映”，在第一步与第二步之间切换，结论按步骤显示与隐藏。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "te-40",
              "type": "listItem",
              "children": [
                {
                  "id": "te-41",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "结束放映后点击“导出”，选择网站或 Notebook。"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  },
