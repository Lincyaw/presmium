{
  "schemaVersion": 1,
  "id": "presmium-tutorial-editing",
  "metadata": {
    "title": "编辑一份讲义",
    "lang": "zh-CN",
    "description": "以“午餐预算”为材料，依次练习复制页面、编辑讲稿、调整播放时机、批注与版本历史、放映与导出。",
    "plugins": [
      "@lincyaw/addon-lecture"
    ],
    "renderers": {
      "web": {},
      "slides": {},
      "notebook": {},
      "lecture": {}
