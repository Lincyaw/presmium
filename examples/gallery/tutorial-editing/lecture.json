    "start-goal": {
      "id": "start-goal",
      "type": "text",
      "content": [
        {
          "id": "te-1",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "这份教程练习在工作台中修改一份讲义：复制页面、编辑正文与讲稿、调整播放时机、批注与查看版本历史，最后放映和导出。练习材料是下一页的“午餐预算”。在工作台中打开本文稿，按页面顺序操作，最后得到另一套方案“午餐方案 B”。修改会自动保存，也可以撤消；全程不需要配置模型或语音服务。"
            }
          ]
        }
      ],
      "only": [
        "web",
        "notebook"
      ]
    },
    "budget-question": {
      "id": "budget-question",
      "type": "text",
      "content": [
        {
          "id": "budget-question-p1",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "每人预算 30 元，主食、配菜、饮品各选一份。怎样确认没有超支？"
            }
          ]
        }
      ]
    },
