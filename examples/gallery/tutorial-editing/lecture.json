  "narrations": {
    "start-narration": {
      "id": "start-narration",
      "content": [
        {
          "type": "text",
          "text": "这份教程用一道午餐预算题做练习。复制页面，改正文和讲稿，最后放映、导出。全程不用配置模型。"
        }
      ]
    },
    "budget-prices": {
      "id": "budget-prices",
      "content": [
        {
          "type": "text",
          "text": "三项价格是：主食十二元，配菜八元，饮品五元。表头的 "
        },
        {
          "type": "pronunciation",
          "display": "¥",
          "spoken": "人民币"
        },
        {
          "type": "text",
          "text": " 符号表示价格以元为单位。"
        },
        {
          "id": "budget-pause",
          "type": "cue",
          "action": "pause",
          "target": {
            "blockId": "budget-table"
          }
        },
        {
          "type": "text",
          "text": "先自己估算一下，会超支吗？"
        }
      ]
    },
    "budget-condition": {
      "id": "budget-condition",
      "content": [
        {
          "type": "text",
          "text": "每样各买一份，按一个人计算。"
        }
      ]
    },
    "budget-result": {
      "id": "budget-result",
      "content": [
        {
          "type": "text",
          "text": "十二加八加五，合计二十五元。三十减二十五，还剩五元，没有超支。"
        }
      ]
    },
    "copy-narration": {
      "id": "copy-narration",
      "content": [
        {
          "type": "text",
          "text": "先复制练习页，再在副本上改价格。副本有自己的正文、步骤和讲稿，原页保持不变。"
        }
      ]
    },
    "scripts-narration": {
      "id": "scripts-narration",
      "content": [
        {
          "type": "text",
          "text": "讲稿按步骤保存，既是配音的文本，也是字幕。所以正文里的价格改了，讲稿里的数字也要跟着改。"
        }
      ]
    },
    "timing-narration": {
      "id": "timing-narration",
      "content": [
        {
          "type": "text",
          "text": "播放时机决定每一步停多久。这一页每步至少停一点二秒，讲完再停零点二五秒；单独一步可以另设，也能恢复。"
        }
      ]
    },
    "comments-narration": {
      "id": "comments-narration",
      "content": [
        {
          "type": "text",
          "text": "批注记下要改的地方。几条批注可以一起交给 AI 修改；没有模型时，编辑和批注也照常可用。"
        }
      ]
    },
    "delivery-narration": {
      "id": "delivery-narration",
      "content": [
        {
          "type": "text",
          "text": "放映和导出都用最近保存的版本。正文、讲稿和时机改好后，可以直接放映，也能导出成网站。"
        }
      ]
    }
  },
