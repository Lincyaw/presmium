                    {
                      "type": "text",
                      "text": "5"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "budget-method": {
      "id": "budget-method",
      "type": "text",
      "content": [
        {
          "id": "budget-method-list",
          "type": "list",
          "ordered": true,
          "children": [
            {
              "id": "budget-method-item1",
              "type": "listItem",
              "children": [
                {
                  "id": "budget-method-line1",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "先估算：12 + 8 是 20，再加 5 也不到 30。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "budget-method-item2",
              "type": "listItem",
              "children": [
                {
                  "id": "budget-method-line2",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "再精算：12 + 8 + 5 = 25。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "budget-method-item3",
              "type": "listItem",
              "children": [
                {
                  "id": "budget-method-line3",
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "text": "最后核对余额：30 − 25 = 5，预算内还剩 5 元。"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "budget-conclusion": {
      "id": "budget-conclusion",
      "type": "text",
