  "blocks": {
    "intro--paragraph-1": {
      "id": "intro--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "intro--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "这份文稿演示用代码写的动画：GSAP、Anime.js、Motion、Three.js 与 Remotion 都跟着讲授的步骤和时间走，讲解、字幕、光标和点击编进同一条时间线，再一帧一帧导出成视频。"
            }
          ]
        }
      ]
    },
    "gsap--bpe": {
      "id": "gsap--bpe",
      "type": "component",
      "definitionId": "gsap--bpe--definition",
      "parameters": {
        "scene": "bpe-merge",
        "alt": "low、lower、lowest 三个词的字节对合并：先合并 l 与 o，再合并 lo 与 w。"
      }
    },
    "gsap--paragraph-1": {
      "id": "gsap--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "gsap--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "字节对编码从单个字符开始：low、lower、lowest 三个词先拆成字母。"
            }
          ]
        }
      ]
    },
    "gsap--paragraph-2": {
      "id": "gsap--paragraph-2",
      "type": "text",
      "content": [
        {
          "id": "gsap--paragraph-2--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "统计相邻的字节对，"
            },
            {
              "type": "extension",
              "kind": "presmium.mdast",
              "schemaVersion": 1,
              "data": {
                "node": {
                  "type": "presmiumRole",
                  "plugin": "presmium.lecture",
                  "name": "cue",
                  "options": {
                    "value": "pause 300ms"
                  },
                  "children": []
                }
              },
              "fallback": ""
            },
            {
              "type": "text",
              "text": " 出现最多的是 l 和 o，三个词里都有。"
            }
          ]
        }
      ]
    },
    "gsap--paragraph-3": {
      "id": "gsap--paragraph-3",
      "type": "text",
      "content": [
        {
          "id": "gsap--paragraph-3--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "把它们合并成一个新符号 lo，"
            },
            {
              "type": "extension",
              "kind": "presmium.mdast",
              "schemaVersion": 1,
              "data": {
                "node": {
                  "type": "presmiumRole",
                  "plugin": "presmium.lecture",
                  "name": "cue",
                  "options": {
                    "to": "bpe",
                    "value": "spot"
                  },
                  "children": []
                }
              },
              "fallback": ""
            },
            {
              "type": "text",
              "text": " 词表里多了一项。"
            }
          ]
        }
      ]
    },
    "gsap--paragraph-4": {
      "id": "gsap--paragraph-4",
      "type": "text",
      "content": [
        {
          "id": "gsap--paragraph-4--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "再数一遍，lo 和 w 最多，合并成 low。"
            },
            {
              "type": "extension",
              "kind": "presmium.mdast",
              "schemaVersion": 1,
              "data": {
                "node": {
                  "type": "presmiumRole",
                  "plugin": "presmium.lecture",
                  "name": "say",
                  "options": {
                    "alias": "B P E",
                    "value": "BPE"
                  },
                  "children": [
                    {
                      "type": "text",
                      "value": "BPE"
                    }
                  ]
                }
              },
              "fallback": "BPE"
            },
            {
              "type": "text",
              "text": " 就这样一轮一轮地长出词表。"
            }
          ]
        }
      ]
    },
    "anime--pipeline": {
      "id": "anime--pipeline",
      "type": "component",
      "definitionId": "anime--pipeline--definition",
      "parameters": {
        "scene": "pipeline",
        "alt": "MyST 源码编译为 IR，再由渲染端生成网页、幻灯片、notebook 与视频。"
      }
    },
    "anime--paragraph-1": {
      "id": "anime--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "anime--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "讲义的源码是 MyST，一份文件。"
            }
          ]
        }
      ]
    },
    "anime--paragraph-2": {
      "id": "anime--paragraph-2",
      "type": "text",
      "content": [
        {
          "id": "anime--paragraph-2--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "编译器把它变成中间表示 IR，只记语义和算好的结果。"
            }
          ]
        }
      ]
    },
    "anime--paragraph-3": {
      "id": "anime--paragraph-3",
      "type": "text",
      "content": [
        {
          "id": "anime--paragraph-3--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "渲染端各取所需：网页、幻灯片、notebook，还有视频。"
            }
          ]
        }
      ]
    },
    "anime--paragraph-4": {
      "id": "anime--paragraph-4",
      "type": "text",
      "content": [
        {
          "id": "anime--paragraph-4--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "视频也从同一份讲义来，讲解就是它的脚本。"
            }
          ]
        }
      ]
    },
    "motion--attention": {
      "id": "motion--attention",
      "type": "component",
      "definitionId": "motion--attention--definition",
      "parameters": {
        "scene": "attention",
        "alt": "句子 The cat sat on the mat 中，查询词 cat 与 mat 对各个词的注意力权重。"
      }
    },
    "motion--paragraph-1": {
      "id": "motion--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "motion--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "查询词 cat 看向句子里的每个词，它自己的权重最大。查询换成 mat，同一组柱子换上新的权重。"
            }
          ]
        }
      ]
    },
    "motion--paragraph-3": {
      "id": "motion--paragraph-3",
      "type": "text",
      "content": [
        {
          "id": "motion--paragraph-3--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "权重最大的是 mat 自己，"
            },
            {
              "type": "extension",
              "kind": "presmium.mdast",
              "schemaVersion": 1,
              "data": {
                "node": {
                  "type": "presmiumRole",
                  "plugin": "presmium.lecture",
                  "name": "cue",
                  "options": {
                    "value": "mark 注意力"
                  },
                  "children": []
                }
              },
              "fallback": ""
            },
            {
              "type": "text",
              "text": " 它亮了起来。"
            }
          ]
        }
      ]
    },
    "three--embedding": {
      "id": "three--embedding",
      "type": "component",
      "definitionId": "three--embedding--definition",
      "parameters": {
        "scene": "embedding",
        "alt": "三维空间中的词向量：散开的点聚成三团，镜头推近其中一团。"
      }
    },
    "three--paragraph-1": {
      "id": "three--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "three--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "词向量一开始散在空间里。 训练之后，意思相近的词聚成了三团。镜头推近其中一团，"
            },
            {
              "type": "extension",
              "kind": "presmium.mdast",
              "schemaVersion": 1,
              "data": {
                "node": {
                  "type": "presmiumRole",
                  "plugin": "presmium.lecture",
                  "name": "cue",
                  "options": {
                    "value": "pause 400ms"
                  },
                  "children": []
                }
              },
              "fallback": ""
            },
            {
              "type": "text",
              "text": " 它们指向差不多的方向。"
            }
          ]
        }
      ]
    },
    "remotion--title": {
      "id": "remotion--title",
      "type": "component",
      "definitionId": "remotion--title--definition",
      "parameters": {
        "scene": "title-card",
        "alt": "Remotion 写的片头：标题弹入，副标题逐字出现，最后升起一枚徽章。"
      }
    },
    "remotion--paragraph-1": {
      "id": "remotion--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "remotion--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "这一页是 Remotion 写的片头，标题弹了进来。"
            }
          ]
        }
      ]
    },
    "remotion--paragraph-2": {
      "id": "remotion--paragraph-2",
      "type": "text",
      "content": [
        {
          "id": "remotion--paragraph-2--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "副标题一个字一个字地打出来。"
            }
          ]
        }
      ]
    },
    "remotion--paragraph-3": {
      "id": "remotion--paragraph-3",
      "type": "text",
