  "narrations": {
    "intro--paragraph-1--narration": {
      "id": "intro--paragraph-1--narration",
      "content": [
        {
          "type": "text",
          "text": "这份文稿演示用代码写的动画：GSAP、Anime.js、Motion、Three.js 与 Remotion 都跟着讲授的步骤和时间走，讲解、字幕、光标和点击编进同一条时间线，再一帧一帧导出成视频。"
        }
      ]
    },
    "gsap--paragraph-1--narration": {
      "id": "gsap--paragraph-1--narration",
      "content": [
        {
          "type": "text",
          "text": "字节对编码从单个字符开始：low、lower、lowest 三个词先拆成字母。"
        }
      ]
    },
    "gsap--paragraph-2--narration": {
      "id": "gsap--paragraph-2--narration",
      "content": [
        {
          "type": "text",
          "text": "统计相邻的字节对，"
        },
        {
          "id": "cue-gsap-1",
          "type": "cue",
          "action": "pause"
        },
        {
          "type": "text",
          "text": " 出现最多的是 l 和 o，三个词里都有。"
        }
      ]
    },
    "gsap--paragraph-3--narration": {
      "id": "gsap--paragraph-3--narration",
      "content": [
        {
          "type": "text",
          "text": "把它们合并成一个新符号 lo，"
        },
        {
          "id": "cue-gsap-1-2",
          "type": "cue",
          "action": "spot",
          "target": {
            "blockId": "gsap--bpe"
          }
        },
        {
          "type": "text",
          "text": " 词表里多了一项。"
        }
      ]
    },
    "gsap--paragraph-4--narration": {
      "id": "gsap--paragraph-4--narration",
      "content": [
        {
          "type": "text",
          "text": "再数一遍，lo 和 w 最多，合并成 low。"
        },
        {
          "type": "pronunciation",
          "display": "BPE",
          "spoken": "B P E"
        },
        {
          "type": "text",
          "text": " 就这样一轮一轮地长出词表。"
        }
      ]
    },
    "anime--paragraph-1--narration": {
      "id": "anime--paragraph-1--narration",
      "content": [
        {
          "type": "text",
          "text": "讲义的源码是 MyST，一份文件。"
        }
      ]
    },
    "anime--paragraph-2--narration": {
      "id": "anime--paragraph-2--narration",
      "content": [
        {
          "type": "text",
          "text": "编译器把它变成中间表示 IR，只记语义和算好的结果。"
        }
      ]
    },
    "anime--paragraph-3--narration": {
      "id": "anime--paragraph-3--narration",
      "content": [
        {
          "type": "text",
          "text": "渲染端各取所需：网页、幻灯片、notebook，还有视频。"
        }
      ]
    },
    "anime--paragraph-4--narration": {
      "id": "anime--paragraph-4--narration",
      "content": [
        {
          "type": "text",
          "text": "视频也从同一份讲义来，讲解就是它的脚本。"
        }
      ]
    },
    "motion--paragraph-1--narration": {
      "id": "motion--paragraph-1--narration",
      "content": [
        {
          "type": "text",
          "text": "查询词 cat 看向句子里的每个词，它自己的权重最大。"
        }
      ]
    },
    "motion--paragraph-2--narration": {
      "id": "motion--paragraph-2--narration",
      "content": [
        {
          "type": "text",
          "text": "查询换成 mat，同一组柱子换上新的权重。"
        }
      ]
    },
    "motion--paragraph-3--narration": {
      "id": "motion--paragraph-3--narration",
      "content": [
        {
          "type": "text",
          "text": "权重最大的是 mat 自己，"
        },
        {
          "id": "cue-motion-1",
          "type": "cue",
          "action": "mark",
          "parameters": {
            "arg": "注意力"
          }
        },
        {
          "type": "text",
          "text": " 它亮了起来。"
        }
      ]
    },
    "three--paragraph-1--narration": {
      "id": "three--paragraph-1--narration",
      "content": [
        {
          "type": "text",
          "text": "词向量一开始散在空间里。"
        }
      ]
    },
    "three--paragraph-2--narration": {
      "id": "three--paragraph-2--narration",
      "content": [
        {
          "type": "text",
          "text": "训练之后，意思相近的词聚成了三团。"
        }
      ]
    },
    "three--paragraph-3--narration": {
      "id": "three--paragraph-3--narration",
      "content": [
        {
          "type": "text",
          "text": "镜头推近其中一团，"
        },
        {
          "id": "cue-three-1",
          "type": "cue",
          "action": "pause"
        },
        {
          "type": "text",
          "text": " 它们指向差不多的方向。"
        }
      ]
    },
    "remotion--paragraph-1--narration": {
      "id": "remotion--paragraph-1--narration",
      "content": [
        {
          "type": "text",
          "text": "这一页是 Remotion 写的片头，标题弹了进来。"
        }
      ]
    },
    "remotion--paragraph-2--narration": {
      "id": "remotion--paragraph-2--narration",
      "content": [
        {
          "type": "text",
          "text": "副标题一个字一个字地打出来。"
        }
      ]
    },
    "remotion--paragraph-3--narration": {
      "id": "remotion--paragraph-3--narration",
      "content": [
        {
          "type": "text",
          "text": "画面由帧号决定，所以导出视频时每一帧都确定。"
        }
      ]
    },
    "click--paragraph-1--narration": {
      "id": "click--paragraph-1--narration",
      "content": [
        {
          "type": "text",
          "text": "这是文稿自己写的组件，“合并一次”是它的具名动作。"
        }
      ]
    },
    "click--paragraph-2--narration": {
      "id": "click--paragraph-2--narration",
      "content": [
        {
          "type": "text",
          "text": "光标移到按钮上。"
        }
      ]
    },
    "click--paragraph-3--narration": {
      "id": "click--paragraph-3--narration",
      "content": [
        {
          "type": "text",
          "text": "讲到这里 "
        },
        {
          "id": "cue-click-1",
          "type": "cue",
          "action": "click",
          "target": {
            "blockId": "click--counter"
          },
          "parameters": {
            "arg": "merge"
          }
        },
        {
          "type": "text",
          "text": " 点一次，词表多了 lo；"
        },
        {
          "id": "cue-click-3",
          "type": "cue",
          "action": "pause"
        },
        {
          "type": "text",
          "text": " 再点 "
        },
        {
          "id": "cue-click-5",
          "type": "cue",
          "action": "click",
          "target": {
            "blockId": "click--counter"
          },
          "parameters": {
            "arg": "merge"
          }
        },
        {
          "type": "text",
          "text": " 一次，又多了 low。"
        }
      ]
    },
    "video--paragraph-1--narration": {
      "id": "video--paragraph-1--narration",
      "content": [
        {
          "type": "text",
          "text": "讲解经语音合成成为讲授轨，字幕、章节和每个提示都在时间线上。导出时一帧一帧推进时间，动画、光标与点击都按讲授的时刻画出来。"
        }
      ]
    }
  },
