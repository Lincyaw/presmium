            }
          ]
        },
        {
          "id": "intro--keywords--timeline",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "跟着步骤播放，逐帧导出成视频"
            }
          ]
        }
      ],
      "only": [
        "slides",
        "lecture"
      ]
    },
