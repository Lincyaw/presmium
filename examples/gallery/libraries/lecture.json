  "blocks": {
    "intro--paragraph-1": {
      "id": "intro--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "intro--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "教学动画可以写成代码，并跟着讲授一步一步走。这份文稿用 GSAP、Anime.js、Motion、Three.js 与 Remotion 各写一段动画，每段都按页面的步骤播放；讲稿、字幕、光标和点击排在同一条时间线上，最后逐帧导出成讲授视频。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "gsap--bpe": {
      "id": "gsap--bpe",
      "type": "component",
      "definitionId": "gsap--bpe--definition",
      "parameters": {
        "scene": "bpe-merge",
        "alt": "low、lower、lowest 三个词的字节对合并：先合并 l 与 o，再合并 lo 与 w。"
      }
    },
    "gsap--paragraph-1": {
      "id": "gsap--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "gsap--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "GSAP 用一条时间线编排补间动画。这一页把时间线按步骤切成四段，每一步播放其中一段。例子是字节对编码（BPE）：low、lower、lowest 三个词先拆成单个字母。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "gsap--paragraph-2": {
      "id": "gsap--paragraph-2",
      "type": "text",
      "content": [
        {
          "id": "gsap--paragraph-2--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "接着统计相邻的字母对。l 和 o 在三个词里都出现，次数最多。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "gsap--paragraph-3": {
      "id": "gsap--paragraph-3",
      "type": "text",
      "content": [
        {
          "id": "gsap--paragraph-3--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "于是把 l 和 o 合并成新符号 lo，词表多了一项。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "gsap--paragraph-4": {
      "id": "gsap--paragraph-4",
      "type": "text",
      "content": [
        {
          "id": "gsap--paragraph-4--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "再统计一遍，lo 和 w 最多，合并成 low。BPE 就这样一轮一轮地扩充词表。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "anime--pipeline": {
      "id": "anime--pipeline",
      "type": "component",
      "definitionId": "anime--pipeline--definition",
      "parameters": {
        "scene": "pipeline",
        "alt": "源文件 lecture.json 编译为 IR，再由渲染端生成网页、幻灯片、notebook 与视频。"
      }
    },
    "anime--paragraph-1": {
      "id": "anime--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "anime--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Anime.js 给页面元素和 SVG 图形加动画。这一页用它画文稿的编译管线，四步依次点亮管线的四个部分。第一步是源文件：一份讲义只有一份源文件。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "anime--paragraph-2": {
      "id": "anime--paragraph-2",
      "type": "text",
      "content": [
        {
          "id": "anime--paragraph-2--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "编译器把源文件变成中间表示 IR。IR 只记录语义和已经算好的结果。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "anime--paragraph-3": {
      "id": "anime--paragraph-3",
      "type": "text",
      "content": [
        {
          "id": "anime--paragraph-3--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "各个渲染端从 IR 取各自需要的内容，生成网页、幻灯片、notebook 和视频。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "anime--paragraph-4": {
      "id": "anime--paragraph-4",
      "type": "text",
      "content": [
        {
          "id": "anime--paragraph-4--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "视频同样来自这份源文件，讲稿就是视频的脚本。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "motion--attention": {
      "id": "motion--attention",
      "type": "component",
      "definitionId": "motion--attention--definition",
      "parameters": {
        "scene": "attention",
        "alt": "句子 The cat sat on the mat 中，查询词 cat 与 mat 对各个词的注意力权重。"
      }
    },
    "motion--paragraph-1": {
      "id": "motion--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "motion--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Motion 让数值和样式平滑地过渡。这一页的柱高是句子 The cat sat on the mat 中各词的注意力权重（示意）。查询词为 cat 时，cat 对自己的权重最大，为 0.46；查询换成 mat 后，同一组柱子过渡到新的高度。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "motion--paragraph-3": {
      "id": "motion--paragraph-3",
      "type": "text",
      "content": [
        {
          "id": "motion--paragraph-3--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "查询词为 mat 时，权重最大的仍是它自己，为 0.50，这根柱子在第三步亮起。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "three--embedding": {
      "id": "three--embedding",
      "type": "component",
      "definitionId": "three--embedding--definition",
      "parameters": {
        "scene": "embedding",
        "alt": "三维空间中的词向量：散开的点聚成三团，镜头推近其中一团。"
      }
    },
    "three--paragraph-1": {
      "id": "three--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "three--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Three.js 在浏览器中绘制三维场景。这一页的点是示意的词向量：训练前散布在空间中，训练后意思相近的词聚成三团。镜头推近其中一团，可以看到这些向量指向大致相同的方向。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "remotion--title": {
      "id": "remotion--title",
      "type": "component",
      "definitionId": "remotion--title--definition",
      "parameters": {
        "scene": "title-card",
        "alt": "Remotion 写的片头：标题弹入，副标题逐字出现，最后升起一枚徽章。"
      }
    },
    "remotion--paragraph-1": {
      "id": "remotion--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "remotion--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Remotion 用 React 组件描述视频的每一帧。这一页的片头中，标题先弹入画面，"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "remotion--paragraph-2": {
      "id": "remotion--paragraph-2",
      "type": "text",
      "content": [
        {
          "id": "remotion--paragraph-2--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "副标题随后逐字出现，"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "remotion--paragraph-3": {
      "id": "remotion--paragraph-3",
      "type": "text",
      "content": [
        {
          "id": "remotion--paragraph-3--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "最后升起一枚写着“每一帧都由时间决定”的徽章。画面只取决于帧号，所以导出视频时每一帧都能准确重现。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "click--counter": {
      "id": "click--counter",
      "type": "component",
      "definitionId": "click--counter--definition",
      "parameters": {}
    },
    "click--paragraph-1": {
      "id": "click--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "click--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "文稿可以带自己编写的组件。下面的计数器是这份文稿的组件，“合并一次”是它的具名动作，讲稿中的提示按这个名字调用它。读者也可以自己点按钮。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "click--pm-cursor-1": {
      "id": "click--pm-cursor-1",
      "type": "component",
      "definitionId": "click--pm-cursor-1--definition",
      "parameters": {
        "path": [
          {
            "to": "#merge-once",
            "action": "move",
            "at": 0
          },
          {
            "to": "#merge-once",
            "action": "click",
            "at": 1
          }
        ]
      }
    },
    "click--paragraph-2": {
      "id": "click--paragraph-2",
      "type": "text",
      "content": [
        {
          "id": "click--paragraph-2--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "讲授时，光标先移到“合并一次”按钮上。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "click--paragraph-3": {
      "id": "click--paragraph-3",
      "type": "text",
      "content": [
        {
          "id": "click--paragraph-3--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "讲稿念到第一个提示时，光标点击一次，词表多了 lo；停顿片刻后再点一次，又多了 low。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "video--code-1": {
      "id": "video--code-1",
      "type": "code",
      "language": "bash",
      "value": "presmium build --to web,lecture\npresmium-lecture export . --burn zh-CN"
    },
    "video--paragraph-1": {
      "id": "video--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "video--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "讲稿经语音合成成为讲授音轨，字幕、章节和每个提示都排在同一条时间线上。导出时逐帧推进这条时间线，五个库写的动画、光标与点击都按讲授中的时刻画出，所以视频与现场讲授一致。上面两条命令先构建网页与讲授形态，再导出烧录中文字幕的视频。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "intro--keywords": {
      "id": "intro--keywords",
      "type": "text",
      "content": [
        {
          "id": "intro--keywords--libraries",
