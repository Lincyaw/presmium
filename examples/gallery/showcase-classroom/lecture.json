          "id": "sr-3",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "下面哪些是稳定的排序算法？"
            }
          ]
        }
      ]
    },
    "multi-quiz": {
      "id": "multi-quiz",
      "type": "component",
      "definitionId": "multi-quiz-definition",
      "parameters": {
        "options": [
          "冒泡排序",
          "归并排序",
          "快速排序"
        ],
        "correct": [
          0,
          1
        ]
      },
      "children": [
        "multi-prompt"
      ]
    },
    "text-6": {
      "id": "text-6",
      "type": "text",
      "content": [
        {
          "id": "sr-4",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "提交后即时显示正误。课堂模式下，由主讲统一公布答案与统计结果。"
            }
          ]
        }
      ]
    },
    "prediction-answer": {
      "id": "prediction-answer",
      "type": "text",
      "content": [
        {
          "id": "paragraph-8",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "答案是 6：0 + 1 + 2 + 3 = 6。"
            }
          ]
        }
      ]
    },
    "prediction-widget": {
      "id": "prediction-widget",
      "type": "component",
      "definitionId": "prediction-widget-definition",
      "parameters": {
        "question": "total = 0，依次累加 1、2、3，最后是多少？",
        "choices": [
          "3",
          "6",
          "9"
        ],
        "reveal": [
          "prediction-answer"
        ]
      },
      "children": [
        "prediction-answer"
      ]
    },
    "text-9": {
      "id": "text-9",
      "type": "text",
      "content": [
        {
          "id": "sr-5",
          "type": "paragraph",
