    "exercise-prompt": {
      "id": "exercise-prompt",
      "type": "text",
      "content": [
        {
          "id": "sr-6",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "实现 square(n)，返回 n 的平方。"
            }
          ]
        }
      ]
    },
    "exercise-widget": {
      "id": "exercise-widget",
      "type": "component",
      "definitionId": "exercise-widget-definition",
      "parameters": {
        "lang": "python",
        "starter": "def square(n):\n    return n",
        "checks": "assert square(2) == 4, \"2 的平方应为 4\"\nassert square(-3) == 9, \"负数的平方也为正\""
      },
      "children": [
        "exercise-prompt"
      ]
    },
    "text-12": {
      "id": "text-12",
