  "definitions": {
    "quiz-widget-definition": {
      "id": "quiz-widget-definition",
      "kind": "component",
      "schemaVersion": 1,
      "implementation": {
        "type": "plugin",
        "plugin": "presmium.classroom",
        "name": "PmQuiz"
      },
      "parameterSchema": {
        "type": "object",
        "properties": {
          "options": {
            "type": "array",
            "title": "选项",
            "items": {
              "type": "string"
            }
          },
          "correct": {
            "type": "array",
            "title": "正确选项序号（从 0 开始）",
            "description": "序号须对应当前选项。",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "options",
          "correct"
        ]
      },
      "states": [],
      "data": {
        "fallback": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
