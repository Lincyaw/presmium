            {
              "type": "text",
              "text": " 应为 4，"
            },
            {
              "type": "text",
              "text": "square(-3)",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " 应为 9。"
