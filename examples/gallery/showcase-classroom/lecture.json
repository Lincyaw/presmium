          "最小的元素",
          "第一个元素"
        ],
        "correct": [
          0
        ]
      },
      "children": [
        "quiz-prompt"
      ]
    },
    "multi-prompt": {
      "id": "multi-prompt",
      "type": "text",
      "content": [
