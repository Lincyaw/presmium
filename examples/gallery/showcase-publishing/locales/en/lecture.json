      "type": "text",
      "content": [
        {
          "id": "sp-7",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "The reader’s “Ask” uses a model service the reader configures. In class, the presenter reviews an AI answer before sharing it."
            }
          ]
        }
      ]
    },
    "text-33": {
      "id": "text-33",
      "type": "text",
      "content": [
        {
          "id": "sp-8",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Websites, notebooks, the student edition, PDF, images and PowerPoint all come from the same document."
            }
          ]
        }
      ]
    },
