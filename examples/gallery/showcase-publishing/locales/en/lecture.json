  "blocks": {
    "text-7": {
      "id": "text-7",
      "type": "text",
      "content": [
        {
          "id": "paragraph-4",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "The website has full-text search: search for “star-river notes” and the result lands on this sentence."
            },
            {
              "type": "extension",
              "kind": "presmium.mdast",
              "schemaVersion": 1,
              "data": {
                "node": {
                  "type": "footnoteReference",
                  "identifier": "reading-footnote",
                  "label": "reading-footnote"
                }
              },
              "fallback": "[note]"
            }
          ]
        },
        {
          "id": "paragraph-5",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "In-page links jump to any page of the document, for example "
            },
            {
              "type": "link",
              "href": "#scope",
              "children": [
                {
                  "type": "text",
                  "text": "“Per-medium output”"
                }
              ]
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "id": "footnote-definition",
          "type": "extension",
          "kind": "presmium.mdast",
          "schemaVersion": 1,
          "data": {
            "node": {
              "type": "footnoteDefinition",
              "identifier": "reading-footnote",
              "label": "reading-footnote",
              "children": [
                {
                  "type": "paragraph",
                  "children": [
                    {
                      "type": "text",
                      "value": "Footnotes hold sources and side remarks: readers consult them when they need to, and the main text reads without interruption."
                    }
                  ]
                }
              ]
            }
          },
          "fallback": [
            {
              "id": "paragraph-6",
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "Footnotes hold sources and side remarks: readers consult them when they need to, and the main text reads without interruption."
                }
              ]
            }
          ]
        }
      ],
      "only": [
        "web",
        "notebook"
      ]
    },
    "text-8": {
      "id": "text-8",
      "type": "text",
      "content": [
        {
          "id": "sp-2",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "To teach, start presenting from the view menu at the top right. While presenting, you can draw on the page, or black out or freeze the screen to bring the audience's attention back to you. The presenter view opens in a separate window and shows the current page, the next page and the script."
            }
          ]
        }
      ],
      "only": [
        "web",
        "notebook"
      ]
    },
    "web-only": {
      "id": "web-only",
      "type": "text",
      "content": [
        {
          "id": "paragraph-15",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "This paragraph appears only on the website."
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    },
    "notebook-only": {
      "id": "notebook-only",
      "type": "text",
      "content": [
        {
          "id": "paragraph-16",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "This paragraph appears only in the notebook."
            }
          ]
        }
      ],
      "only": [
        "notebook"
      ]
    },
    "text-18": {
      "id": "text-18",
      "type": "text",
      "content": [
        {
          "id": "sp-3",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "A block's "
            },
            {
              "type": "text",
              "text": "only",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " field lists the media that show it; a block without "
            },
            {
              "type": "text",
              "text": "only",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " appears in every medium. The next two paragraphs are limited to the website and to the notebook, so each of those shows only one of them. The slides show neither and display a line written for presenting instead."
            }
          ]
        }
      ],
      "only": [
        "web",
        "notebook"
      ]
    },
    "text-20": {
      "id": "text-20",
      "type": "text",
      "content": [
        {
          "id": "sp-4",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "A document can bring a local plugin that registers its own web components. The counter below is registered by the plugin in this document's "
            },
            {
              "type": "text",
              "text": "plugin",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " folder; it starts at 2 and goes up by one with each click."
            }
          ]
        }
      ],
      "only": [
        "web",
        "notebook"
      ]
    },
    "text-23": {
      "id": "text-23",
      "type": "text",
      "content": [
        {
          "id": "web-component-node",
          "type": "extension",
          "kind": "presmium.mdast",
          "schemaVersion": 1,
          "data": {
            "node": {
              "type": "html",
              "value": "<presmium-feature-counter label=\"Web Component\" start=\"2\"></presmium-feature-counter>"
            }
          },
          "fallback": [
            {
              "id": "paragraph-22",
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "Web Component counter: starts at 2 and increases when clicked."
                }
              ]
            }
          ]
        }
      ]
    },
    "contrast": {
      "id": "contrast",
      "type": "component",
      "definitionId": "contrast-definition",
      "parameters": {}
    },
    "text-24": {
      "id": "text-24",
      "type": "text",
      "content": [
        {
          "id": "sp-5",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "The high-contrast switch raises the contrast between text and background, which helps readers with low vision and projection in a bright room. A published website can be saved locally and read offline."
            }
          ]
        }
      ],
      "only": [
        "web",
        "notebook"
      ]
    },
    "text-27": {
      "id": "text-27",
      "type": "text",
      "content": [
        {
          "id": "sp-6",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "This document exists in Chinese and English, and readers switch between the two with the language menu. The translation's pages, blocks and steps correspond one to one with the original's."
            }
          ]
        }
      ],
      "only": [
        "web",
        "notebook"
      ]
    },
    "text-30": {
      "id": "text-30",
      "type": "text",
      "content": [
        {
          "id": "sp-7",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "With “Ask”, readers put questions about the content to an AI, using a model service they configure themselves. In class, the presenter reviews each AI answer before it is sent to the whole class."
            }
          ]
        }
      ],
      "only": [
        "web",
        "notebook"
      ]
    },
    "text-33": {
      "id": "text-33",
      "type": "text",
      "content": [
        {
          "id": "sp-8",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "The website, the notebook, the student edition, PDF, images and PowerPoint all come from this one lecture.json: content is written once, and after each build every output agrees with the others. The first two commands below build the website and notebook, and the student edition of the website; "
            },
            {
              "type": "text",
              "text": "presmium-export --help",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " lists the PDF, image and PowerPoint exports."
            }
          ]
        }
      ],
      "only": [
        "web",
        "notebook"
      ]
    },
    "export-commands": {
      "id": "export-commands",
      "type": "code",
      "language": "shell",
      "value": "presmium build showcase-publishing --to web,notebook\npresmium build showcase-publishing --to web --audience student\n# presmium-export --help lists PDF, image and PowerPoint export"
    },
    "g-read-intro": {
      "id": "g-read-intro",
      "type": "text",
      "content": [
        {
          "id": "g-read-intro-p",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Once a document is published, readers and authors each get a set of features. On the website, readers can search the full text, read footnotes, present, switch to high contrast or another language, and ask an AI about the content. From the same lecture.json, authors choose content per medium, add their own web components, and produce a website, a notebook, a student edition, PDF, images and PowerPoint. The five pages in this part show the reader's side."
            }
          ]
        }
      ],
      "only": [
        "web",
        "notebook"
      ]
    },
    "g-output-intro": {
      "id": "g-output-intro",
      "type": "text",
      "content": [
        {
          "id": "g-output-intro-p",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "On the author's side, one document serves several media: a block can be limited to some media, a local plugin can add custom web components, and the build and export commands produce a website, a notebook, a student edition, PDF, images and PowerPoint. The three pages in this part show each in turn."
            }
          ]
        }
      ],
      "only": [
        "web",
        "notebook"
      ]
    },
