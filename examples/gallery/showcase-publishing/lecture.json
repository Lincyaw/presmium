    },
    "text-30": {
      "id": "text-30",
      "type": "text",
      "content": [
        {
          "id": "sp-7",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "阅读页的“提问”功能使用读者自行配置的模型服务。课堂中，AI 的回答经主讲审阅后再发送给全班。"
            }
          ]
        }
      ]
    },
    "text-33": {
      "id": "text-33",
      "type": "text",
      "content": [
        {
          "id": "sp-8",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "网页、notebook、学生版以及 PDF、图片、PowerPoint 均由同一份文稿生成。"
            }
          ]
        }
      ]
    },
    "export-commands": {
      "id": "export-commands",
      "type": "code",
      "language": "shell",
      "value": "presmium build showcase-publishing --to web,notebook\npresmium build showcase-publishing --to web --audience student\n# presmium-export --help 查看 PDF、图片与 PowerPoint 导出"
