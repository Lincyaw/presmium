  "narrations": {
    "script-intro": {
      "id": "script-intro",
      "content": [
        {
          "type": "text",
          "text": "这里展示 "
        },
        {
          "type": "pronunciation",
          "display": "SQL",
          "spoken": "sequel"
        },
        {
          "type": "text",
          "text": " 的读音标记。"
        },
