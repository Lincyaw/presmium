    "mechanism-scene": {
      "id": "mechanism-scene",
      "type": "component",
      "definitionId": "mechanism-definition",
      "parameters": {
        "frames": [
          {
            "title": "一次任务，留下完整轨迹",
            "labels": [
              "提问",
              "找到资料",
              "无用检索",
              "整合证据",
              "回答",
              "时间顺序",
              "机制示意"
            ],
            "source": "方法 §2.1 · 具体任务为机制示意"
          },
          {
            "title": "同一批轮次，按结果依赖重排",
            "labels": [
              "结果依赖",
              "第二轮 → 第四轮 → 回答",
              "第三轮：无下游使用"
            ],
            "source": "方法 §2.2 · DAG为轮次依赖图"
          },
          {
            "title": "L1：剪掉没有下游用途的分支",
            "labels": [
              "无下游用途",
              "保留问题与最终回答",
              "保留证据链"
            ],
            "source": "方法 §2.3 · Leaf Prune，迭代剪枝"
          }
        ]
      }
    },
    "merge-scene": {
      "id": "merge-scene",
      "type": "component",
      "definitionId": "merge-definition",
      "parameters": {
        "frames": [
          {
            "title": "L2：合并同上游、同下游的查询",
            "labels": [
              "比较任务",
              "查询对象甲",
              "查询对象乙",
              "整合比较",
              "同上游 · 同下游",
              "独立查询 → 同一轮"
            ],
            "source": "方法 §2.3 · Strict Merge，例子为机制示意"
          },
          {
            "title": "L2a：连接思考，保留工具证据",
            "labels": [
              "先查甲的信息",
              "再查乙的信息",
              "分别查询甲乙，再汇总比较",
              "工具调用 + 返回内容：原样保留",
              "L2 + 连贯改写 → L2a"
            ],
            "source": "方法 §2.4 · 只改写合并后的思考文本"
          }
        ]
      }
    },
