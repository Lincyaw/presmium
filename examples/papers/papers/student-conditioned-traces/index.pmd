        "frames": [
          {
            "id": "ending",
            "title": "围绕学生草稿改写，再让学生参与选择",
            "labels": [],
            "source": "arXiv 2610.23831v1"
          }
        ],
        "alt": "让学生的草稿，变成学生能用的示范",
        "summary": "围绕学生草稿改写，再让学生参与选择",
        "paper": "Beyond the Answer · ReDiST"
