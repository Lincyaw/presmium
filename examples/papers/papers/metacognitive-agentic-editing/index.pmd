    "problem--scene": {
      "id": "problem--scene",
      "type": "component",
      "definitionId": "problem--definition",
      "parameters": {
        "frames": [
          {
            "id": "trace",
            "title": "学生会连同教师的习惯一起学",
            "labels": [
              "一条推理轨迹 · 示意"
            ],
            "lines": [
              "求 x² = 9 的全部实数解",
              "开平方：x = 3",
              "代回：3² = 9",
              "所以只有一个解"
            ],
            "source": "机制示意 · 论文 §1、§3.2"
          },
          {
            "id": "check",
            "title": "检查必须说清：查什么，查出了什么",
            "labels": [
              "检验解是否完整",
              "(−3)² = 9",
              "还存在 x = −3",
              "实质验证：对象 + 结果"
            ],
            "source": "示意例题 · 论文 §3.2"
          }
        ],
        "alt": "答对和会检查，是两回事"
      }
    },
    "edit--scene": {
      "id": "edit--scene",
      "type": "component",
      "definitionId": "edit--definition",
      "parameters": {
        "frames": [
          {
            "id": "plan",
            "title": "先补规划，让解题步骤有目标",
            "labels": [
              "同一份轨迹",
              "先找候选解 → 再验完备性",
              "子目标规划"
            ],
            "lines": [
              "求 x² = 9 的全部实数解",
              "开平方：x = 3",
              "代回：3² = 9",
              "所以只有一个解"
            ],
            "source": "机制示意 · 论文 §3.2—3.3"
          },
          {
            "id": "repair",
            "title": "保留错误步骤，在后面接上修正",
            "labels": [
              "补充：x = −3 也满足，解为 ±3",
              "保留原错误",
              "在错误后面更正"
            ],
            "source": "机制示意 · MBT-A 编辑规则"
          }
        ],
        "alt": "在具体推断处插入内容"
      }
    },
