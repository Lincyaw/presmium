  "opening--scene": {
   "id": "opening--scene",
   "type": "component",
   "definitionId": "opening--scene--definition",
   "parameters": {
    "scene": "opening",
    "alt": "翰林院传达室的信使猫标志，旁边是“三分钟读完一篇论文”和“翰林院传达室”；下方是今天的论文：Subconscious Systems、MIT、普林斯顿大学与东北大学，Adversarial Speculative Reasoning Improves Long Horizon Agents（对抗式推测推理），arXiv 2611.05345。",
    "institution": "Subconscious Systems、MIT、普林斯顿大学与东北大学",
    "title": "Adversarial Speculative Reasoning",
    "titleZh": "对抗式推测推理",
    "authors": "Hongyin Luo, Wei Fang, Lijie Yang 等",
    "venue": "arXiv 2611.05345 · 2026"
   }
  },
  "problem--scene": {
   "id": "problem--scene",
   "type": "component",
   "definitionId": "problem--scene--definition",
   "parameters": {
    "scene": "problem",
    "alt": "long-horizon agent 的轨迹与一个八槽 verification block（验证块）；论文图 1 显示 verification slot 0 到 7 的数值噪声增加百分之三十四，论文图 2 显示验证写入的上下文在三十轮后产生更多极端偏差。",
    "label": "verification block 内的精度递减与长程影响"
   }
  },
  "method--scene": {
   "id": "method--scene",
   "type": "component",
   "definitionId": "method--scene--definition",
   "parameters": {
    "scene": "method",
    "alt": "ordinary draft model 让关键决策落在 slot 5；adversarial draft 在 decision point 提出应避免的判断，被 target model 拒绝并从 residual distribution（残差分布）采样，新的 verification block 把关键决策写在最精确的 slot 0。",
    "label": "拒绝成为精度控制通道"
   }
  },
  "training--scene": {
   "id": "training--scene",
   "type": "component",
   "definitionId": "training--scene--definition",
   "parameters": {
    "scene": "training",
    "alt": "从智能体轨迹中定位 committing sentence（决策句），从同一前缀采样出可取与应避免的续写，构成 fork pair（同源分叉对）与 preference pair（偏好对），再反向训练 draft model 偏好 adversarial side；只训练 draft model 中很小的一部分参数。",
    "label": "committing sentence、fork pair 与反向训练"
   }
  },
  "evidence--scene": {
   "id": "evidence--scene",
   "type": "component",
   "definitionId": "evidence--scene--definition",
   "parameters": {
    "scene": "evidence",
    "alt": "论文图 4 显示 draft model 学会 decision frame（决策框架）与 run tests（运行测试）偏好；DeepSWE 和 NL2Repo-Bench 的通过率均提升；最后的 accepted length（接受长度）图显示该指标至多下降约百分之二。",
    "label": "偏好、两个基准与解码速度"
   }
  },
  "controls--scene": {
   "id": "controls--scene",
   "type": "component",
   "definitionId": "controls--scene--definition",
   "parameters": {
    "scene": "controls",
    "alt": "DeepSWE 对照实验：preferred direction 训练时通过率下降，换无关偏好没有提升；因果链显示 decision point 先触发拒绝，再从新 verification block 的 slot 0 写入，因此收益来自拒绝位置而不是任何草稿训练。",
    "label": "反向偏好、无关偏好与机制"
   }
  },
  "close--scene": {
   "id": "close--scene",
   "type": "component",
   "definitionId": "close--scene--definition",
   "parameters": {
    "scene": "close",
    "alt": "target model 与 exact verification 不变，给定 KV context 时 output distribution 也不变；只训练整套系统中百分之零点零六到百分之零点二八的 draft 参数。结论页同时列出 accepted length 至多下降约百分之二、两个约七千五百亿参数模型与长程编程任务。",
    "label": "context precision 的分配器"
   }
  },
  "ending--scene": {
   "id": "ending--scene",
   "type": "component",
   "definitionId": "ending--scene--definition",
   "parameters": {
    "scene": "ending",
    "alt": "结尾：一句话总结论文做了什么；下方是对话气泡和“想看哪篇论文？评论区告诉我们”，右侧是翰林院传达室的标志与“为您分享最新论文 · 下期见”。",
    "summary": "让关键决策句首 token 落在最精确 verification slot",
    "paper": "Adversarial Speculative Reasoning · arXiv 2611.05345"
   }
  }
 },
