// Development container of the sample repository. Presmium's local environment
// (P-22) runs presented code in the image built from this definition.
{
  "name": "presmium-sample-repo",
  "image": "python:3.12-slim",
  "customizations": {
    "presmium": {
      // language -> command that receives the code as its last argument
      "runners": {
        "python": ["python3", "-c"]
      }
    }
  }
}
