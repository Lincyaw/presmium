  "blocks": {
    "opening--scene": {
      "id": "opening--scene",
      "type": "component",
      "definitionId": "opening--scene--definition",
      "parameters": {
        "scene": "opening",
        "alt": "翰林院传达室的信使猫标志，旁边是“三分钟读完一篇论文”和“翰林院传达室”；下方是今天的论文：斯坦福大学，Hinted Scaling Laws（带提示的缩放定律），arXiv 2611.02270。",
        "institution": "斯坦福大学",
        "title": "Hinted Scaling Laws",
        "titleZh": "带提示的缩放定律",
        "authors": "Suze van Adrichem, Luke Bailey, Rohith Kuditipudi 等",
        "venue": "arXiv 2611.02270 · 2026"
      }
    },
    "problem--scene": {
      "id": "problem--scene",
      "type": "component",
      "definitionId": "problem--scene--definition",
      "parameters": {
        "scene": "problem",
        "alt": "横轴为训练算力（对数刻度）的图：Delphi 系列十个小模型的 GSM8K 准确率都贴近零，每个点上方是一列按提示量着色的点，提示越多准确率越高；右侧依次写着“缩放定律：小模型的趋势 → 大模型”“预训练损失：有趋势”“下游准确率：一排零分”，以及“提示：给小模型看一部分参考解答”。"
      }
    },
    "hint--scene": {
      "id": "hint--scene",
      "type": "component",
      "definitionId": "hint--scene--definition",
      "parameters": {
        "scene": "hint",
        "alt": "左侧是 GSM8K 的 256 道题排成的 16×16 方格，一个 10²¹ FLOPs 的模型在提示量 H = 1 时做对的题亮成橙色；右侧是它的准确率随提示量从 1.8% 平滑上升到 80.9% 的曲线。"
      }
    },
    "law--scene": {
      "id": "law--scene",
      "type": "component",
      "definitionId": "law--scene--definition",
      "parameters": {
        "scene": "law",
        "alt": "论文图 3 的遮盖面板：横轴训练算力，纵轴提示量，等准确率线大致平行；上方是联合定律的公式 L(C, H) = max(F, L + (A − L)·σ(β₁C + β₂H + β₃))，H = 0 的底边标为“对原题的预测”。"
      }
    },
    "forecast--scene": {
      "id": "forecast--scene",
      "type": "component",
      "definitionId": "forecast--scene--definition",
      "parameters": {
        "scene": "forecast",
        "alt": "19 组预测的误差对比：每一行一组模型家族与基准，黑点是标准缩放定律对最大模型的预测误差，红点是带提示的预测误差，17 组红点更小，中位误差从 21 个百分点降到 4.3。"
      }
    },
    "ranking--scene": {
      "id": "ranking--scene",
      "type": "component",
      "definitionId": "ranking--scene--definition",
      "parameters": {
        "scene": "ranking",
        "alt": "左侧：七个模型在 AIME 上的原题准确率（都不到 1%）与加提示后的准确率（H = 0.7）用连线相连，顺序基本不变；右侧：排序与真值的一致性（Kendall τ）随每题采样次数增加，带提示的排序在一次采样时为 0.51，普通采样要约五次才追上。"
      }
    },
    "close--scene": {
      "id": "close--scene",
      "type": "component",
      "definitionId": "close--scene--definition",
      "parameters": {
        "scene": "close",
        "alt": "结论：提示量是衡量能力的第二把尺子；前提是每道题有可靠的参考解答。下方是论文信息：Hinted Scaling Laws，斯坦福大学，arXiv 2611.02270，代码 github.com/tatsu-lab/hinted-scaling-laws。"
      }
    },
    "notes--text": {
      "id": "notes--text",
      "type": "text",
      "content": [
        {
          "id": "notes--t0",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "论文"
            }
          ]
        },
        {
          "id": "notes--t1",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Suze van Adrichem, Luke Bailey, Rohith Kuditipudi, Christine Ye, Neil Band, Ahmed Ahmed, John Duchi, Percy Liang, Tatsunori Hashimoto. Hinted Scaling Laws. arXiv 2611.02270, 2026. 代码与数据：github.com/tatsu-lab/hinted-scaling-laws。"
            }
          ]
        },
        {
          "id": "notes--t2",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "画面里的数字从哪里来"
            }
          ]
        },
        {
          "id": "notes--t3",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "动画中的每个数字都由论文公开的逐次采样结果重新计算（scenes/data/derive.py，按论文式 (2) 与它的多起点最小二乘拟合），与论文报告的数值一致。Delphi 系列 10²³ FLOPs 模型在 GSM8K 上的准确率为 25.87%。只用不超过 9×10¹⁹ FLOPs 的六个模型、以 logit 混合加提示时（教师是上下文里放着完整参考解答的 Llama-3.1-8B-Instruct，H 是它的 logits 的权重，取 0 到 16），联合定律预测 28.73%，误差 2.86 个百分点；在留出的 10²² FLOPs 模型上它预测 13.3%，实际 7.4%，高估 5.9 个百分点。标准缩放定律（同样六个模型的原题准确率对算力拟合的 S 形曲线）预测 13.17%，误差 12.70。五组模型与三个基准的 19 组预测用截断与遮盖两种只需参考解答的提示，取两者预测的平均（Delphi 一组从 7 个模型起拟合，与论文图 5 相同），17 组好于标准缩放定律，中位误差从 20.8 降到 4.3 个百分点。AIME 上每题一次采样时，带提示的排序与真值（每题 4,096 次原题采样）的 Kendall τ 为 0.51，普通采样为 0.18。"
            }
          ]
        },
        {
          "id": "notes--t4",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "“多给 0.1 的提示约等于三倍算力”由遮盖在 Delphi 上拟合的联合定律计算（β₂/β₁ ≈ 4.7，即每 0.1 的提示约合 0.47 个数量级的算力），是估算；联合定律那一页的拟合用了全部 12 个模型，只用来看形状，论文图 3 的实测等准确率线在接近噪声底时偏离直线。第一页中“与零分相容”的几条 S 形曲线是示意。"
            }
          ]
        },
        {
          "id": "notes--t5",
          "type": "heading",
          "level": 3,
          "children": [
            {
              "type": "text",
              "text": "条件"
            }
          ]
        },
        {
          "id": "notes--t6",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "截断与遮盖需要每道题有一份正确、推理清楚并去掉最终答案的参考解答；logit 混合还需要一个与被测模型共用分词器、明显更强的教师模型。论文的预测实验中只有 Delphi 是严格按一个配方训练的规模系列，其余家族是公开发布的模型。"
            }
          ]
        }
      ],
      "only": [
        "web"
      ]
    }
  },
