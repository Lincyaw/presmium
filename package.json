{
  "name": "presmium-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "studio": "node scripts/studio.mjs",
    "debug:studio": "node scripts/debug-studio.mjs",
    "test": "node scripts/check-layering.mjs && node scripts/check-skills.mjs && node scripts/check-plugins.mjs && node scripts/check-packages.mjs && node scripts/check-tokens.mjs && node scripts/check-i18n.mjs --strict --summary && node scripts/check-types.mjs && vitest run --passWithNoTests",
    "demo:build": "pnpm --filter presmium-animations build",
    "demo:check": "pnpm --filter presmium-animations check",
    "demo:ir": "pnpm --filter presmium-animations ir",
    "e2e": "pnpm --filter presmium-regression-fixture build && playwright test",
    "verify": "pnpm test && pnpm demo:check && pnpm demo:build && pnpm e2e",
    "docs:fetch": "./scripts/fetch-docs.sh",
    "changeset": "changeset",
    "release:check": "pnpm -r publish --dry-run --no-git-checks",
    "consumer": "node scripts/consumer.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@lincyaw/addon-motion": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.19.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sirv-cli": "^3.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
