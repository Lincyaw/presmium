// The remote environment as a dev container: the same compose definition (../compose.yaml), to work
// in it locally (VS Code, the Dev Containers CLI) or to replicate it. Its variables come from
// the shell, as for docker compose: JUPYTER_TOKEN is required.
{
  "name": "Presmium remote environment",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "jupyter",
  "workspaceFolder": "/home/jovyan",
  "remoteUser": "jovyan",
  // The container runs its Jupyter Server, as it does under docker compose.
  "overrideCommand": false,
  "shutdownAction": "stopCompose"
}
