# What the image takes from the checkout, and nothing else (an allow-list, WP-91): the operator's files
# beside compose.yaml (.env, oauth2-proxy.env, secrets/, seed/), git's data, outputs and caches never
# reach the build context, so neither the image nor the sandbox's user can read them.
*
!package.json
!pnpm-workspace.yaml
!node_modules
!packages
!examples/demo/node_modules
!templates/document
!templates/workspace/compose/init.sh
!templates/workspace/.gitignore
# node_modules stays whole (its packages' own dist/ directories are their code); Presmium's packages
# without their tests and outputs.
packages/*/test
packages/*/dist
