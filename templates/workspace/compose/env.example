# Copy to .env. Third-party credentials: compose gives this file to the gateway only (env_file), and
# serve refuses to start when its own environment has any. Leave out what you do not use.

# Model access for the assistant (D11): DeepSeek's own service...
# DEEPSEEK_API_KEY=
# ...or a Messages-compatible service, all three.
# PRESMIUM_MODEL_URL=
# PRESMIUM_MODEL_KEY=
# PRESMIUM_MODEL_PROVIDER=

# Speech engines: PRESMIUM_SPEECH_<ID>_URL, _KEY, _PROVIDER.
# PRESMIUM_SPEECH_VOLCENGINE_APPID=
# PRESMIUM_SPEECH_VOLCENGINE_KEY=

# Remote environments: PRESMIUM_ENV_<NAME>_URL and PRESMIUM_ENV_<NAME>_TOKEN, in pairs.
# PRESMIUM_ENV_GPU_URL=
# PRESMIUM_ENV_GPU_TOKEN=

# Compose's own settings (interpolated in compose.yaml, not given to any container).
PRESMIUM_CONSOLE_HOST=console.course.example.edu
# PRESMIUM_PORT=8080
# PRESMIUM_EDGE=172.31.79
