# Copy to oauth2-proxy.env: the login proxy's settings (oauth2-proxy's own variables). The cookie's
# domain covers the site's and the owner console's host names, so members log in once.
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://login.example.edu/realms/course
OAUTH2_PROXY_CLIENT_ID=presmium
OAUTH2_PROXY_CLIENT_SECRET=change-me
# 32 random bytes, base64: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=change-me-change-me-change-me-32b
OAUTH2_PROXY_COOKIE_DOMAINS=.course.example.edu
OAUTH2_PROXY_WHITELIST_DOMAINS=.course.example.edu
OAUTH2_PROXY_REDIRECT_URL=https://course.example.edu/oauth2/callback
OAUTH2_PROXY_EMAIL_DOMAINS=*
