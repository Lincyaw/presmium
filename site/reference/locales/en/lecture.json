  "blocks": {
    "reference--body-0": {
      "id": "reference--body-0",
      "type": "text",
      "content": [
        {
          "id": "reference--body-0--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Editable documents, runtime snapshots and plugin contracts have separate version boundaries. Identify the layer you read or write before checking versions. API in the navigation contains signatures generated from source."
            }
          ]
        }
      ]
    },
    "versions--body-0": {
      "id": "versions--body-0",
      "type": "text",
      "content": [
        {
          "id": "versions--body-0--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Package versions identify installed implementations. DOCUMENT_SCHEMA_VERSION and schemaVersion identify editable documents. IR_VERSION and ir identify runtime snapshots. KERNEL_VERSION identifies plugin contracts. Check each relevant boundary separately."
            }
          ]
        }
      ]
    },
    "versions-packages--body-0": {
      "id": "versions-packages--body-0",
      "type": "text",
      "content": [
        {
          "id": "versions-packages--body-0--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "package.json and the pnpm lockfile pin project dependencies. Plugins declare peer ranges for the host, kernel and compiler packages they use. An incompatible plugin is unavailable and produces a diagnostic."
            }
          ]
        }
      ]
    },
    "versions-packages--body-1": {
      "id": "versions-packages--body-1",
      "type": "text",
      "content": [
        {
          "id": "versions-packages--body-1--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Use exports and TypeScript declarations from the installed release. Task examples do not replace installed command help and contracts."
            }
          ]
        }
      ]
    },
    "versions-ir--body-0": {
      "id": "versions-ir--body-0",
      "type": "text",
      "content": [
        {
          "id": "versions-ir--body-0--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "The editable format currently uses schemaVersion: 1 and the canonical lecture.json entry. Shared validation checks IDs, references, ownership, parameters, states and media ranges. Old MyST source is not a runtime input."
            }
          ]
        }
      ]
    },
    "versions-ir--body-1": {
      "id": "versions-ir--body-1",
      "type": "text",
      "content": [
        {
          "id": "versions-ir--body-1--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "IRDocument is derived and contains resolved steps, states, resources and findings. Renderers consume it. Editors, agents and workspace transactions read and write TeachingDocument rather than reconstructing authoritative content from a snapshot."
            }
          ]
        }
      ]
    },
    "versions-kernel--body-0": {
      "id": "versions-kernel--body-0",
      "type": "text",
      "content": [
        {
          "id": "versions-kernel--body-0--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Node and browser plugins declare compatible kernel ranges. A plugin shares the host contract and service runtime. Incompatibility, missing implementations and unavailable services remain explicit diagnostics."
            }
          ]
        }
      ]
    },
    "public--body-0": {
      "id": "public--body-0",
      "type": "text",
      "content": [
        {
          "id": "public--body-0--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "@lincyaw/kernel supplies document, snapshot, plugin and service contracts. @lincyaw/host supplies browser host hooks and services. @lincyaw/compiler supplies compilation and build APIs. @lincyaw/viewer supplies runtime view extensions."
            }
          ]
        }
      ]
    },
    "public--body-1": {
      "id": "public--body-1",
      "type": "text",
      "content": [
        {
          "id": "public--body-1--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Import declared public paths. Avoid compiled output directories, dependency internals, private editor state and another plugin implementation."
            }
          ]
        }
      ]
    },
    "public-documents--body-0": {
      "id": "public-documents--body-0",
      "type": "text",
      "content": [
        {
          "id": "public-documents--body-0--text",
          "type": "code",
          "language": "sh",
          "value": "presmium --help\npresmium check --help\npresmium build --help\npresmium serve --help"
        }
      ]
    },
    "public-documents--body-1": {
      "id": "public-documents--body-1",
      "type": "text",
      "content": [
        {
          "id": "public-documents--body-1--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "presmium.workspace.yaml groups lecture.json entries. Keep credentials and operator settings separate from content. Confirm document, save, snapshot and audio-cache versions independently. Late responses cannot represent newer input."
            }
          ]
        }
      ]
    },
    "public-contracts--body-0": {
      "id": "public-contracts--body-0",
      "type": "text",
      "content": [
        {
          "id": "public-contracts--body-0--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "validateDocument, DOCUMENT_JSON_SCHEMA and TeachingDocument form one authoring contract shared by Web, agents, direct file edits and compilation. Workspace changes carry baseDocumentVersion. Conflicts retain input. With workspace MCP, start with get_authoring_capabilities, then use get_document, plan_document_change and apply_document_change to read, preflight and commit. Receipts distinguish saved source from compilation and runtime verification that were not requested."
            }
          ]
        }
      ]
    },
    "public-contracts--body-1": {
      "id": "public-contracts--body-1",
      "type": "text",
      "content": [
        {
          "id": "public-contracts--body-1--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Findings have stable check IDs, severity and locations. A failed compile may keep the last successful snapshot, but its staleness must be visible. It cannot acknowledge the current document version."
            }
          ]
        }
      ]
    },
    "experimental-workbench--body-0": {
      "id": "experimental-workbench--body-0",
      "type": "text",
      "content": [
        {
          "id": "experimental-workbench--body-0--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "Workbench UI and private service routes can change with the implementation. Prefer host and service contracts. Pin installed versions when relying on experimental interfaces and verify the real integration. Body editing, compiled presentation and video production have separate lifecycles."
            }
          ]
        }
      ]
    },
    "experimental-workbench--body-1": {
      "id": "experimental-workbench--body-1",
      "type": "text",
      "content": [
        {
          "id": "experimental-workbench--body-1--text",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "For content authoring, read the "
            },
            {
              "type": "link",
              "href": "../../../guide/lecture.json",
              "children": [
                {
                  "type": "text",
                  "text": "author guide"
                }
              ]
            },
            {
              "type": "text",
              "text": ". Component development is covered by the plugin guide."
            }
          ]
        }
      ]
    }
  },
