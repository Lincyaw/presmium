    "shader--add": {
      "id": "shader--add",
      "type": "component",
      "definitionId": "shader--add--definition",
      "parameters": {
        "params": {
          "buffers": {
            "a": [
              1,
              2,
              3,
              4
            ],
            "b": [
              10,
