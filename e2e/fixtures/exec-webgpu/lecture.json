        "shader--add--source"
      ]
    },
    "shader--add--source": {
      "id": "shader--add--source",
      "type": "code",
      "language": "wgsl",
      "value": "@group(0) @binding(0) var<storage, read> a: array<f32>;\n@group(0) @binding(1) var<storage, read> b: array<f32>;\n@group(0) @binding(2) var<storage, read_write> out: array<f32>;\n\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) id: vec3<u32>) {\n  if (id.x < arrayLength(&out)) {\n    out[id.x] = a[id.x] + b[id.x];\n  }\n}",
      "execution": {
        "when": "both",
        "args": {
          "buffers": "{\"a\":[1,2,3,4],\"b\":[10,20,30,40],\"out\":{\"size\":4}}",
          "dispatch": "1",
          "repeat": "5"
        }
      }
    },
    "python--paragraph-1": {
      "id": "python--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "python--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "同一个着色器经 "
            },
            {
              "type": "text",
              "text": "presmium_gpu",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " 运行：先用 "
            },
            {
              "type": "text",
              "text": "await",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": "，再用同步写法（需要 JSPI）；超过规模限制的缓冲区与重复次数在请求 GPU 之前就被拒绝。"
            }
          ]
        }
      ]
    },
    "python--py-async": {
      "id": "python--py-async",
      "type": "code",
      "language": "python",
      "value": "import presmium_gpu as gpu\n\nSHADER = \"\"\"\n@group(0) @binding(0) var<storage, read> a: array<f32>;\n@group(0) @binding(1) var<storage, read> b: array<f32>;\n@group(0) @binding(2) var<storage, read_write> out: array<f32>;\n\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) id: vec3<u32>) {\n  if (id.x < arrayLength(&out)) {\n    out[id.x] = a[id.x] + b[id.x];\n  }\n}\n\"\"\"\nresult = await gpu.run(SHADER, buffers={'a': [1, 2, 3, 4], 'b': [10, 20, 30, 40], 'out': {'size': 4}})\nprint(result)",
      "execution": {
        "when": "live"
      }
    },
    "python--py-sync": {
      "id": "python--py-sync",
      "type": "code",
      "language": "python",
      "value": "import presmium_gpu as gpu\n\nSHADER = \"\"\"\n@group(0) @binding(0) var<storage, read> a: array<f32>;\n@group(0) @binding(1) var<storage, read> b: array<f32>;\n@group(0) @binding(2) var<storage, read_write> out: array<f32>;\n\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) id: vec3<u32>) {\n  if (id.x < arrayLength(&out)) {\n    out[id.x] = a[id.x] + b[id.x];\n  }\n}\n\"\"\"\nprint('JSPI:', gpu.can_run_sync())\nprint(gpu.run_sync(SHADER, buffers={'a': [1, 2, 3, 4], 'b': [10, 20, 30, 40], 'out': {'size': 4}})['out'])",
      "execution": {
        "when": "live"
      }
    },
    "python--py-limits": {
      "id": "python--py-limits",
      "type": "code",
      "language": "python",
      "value": "import presmium_gpu as gpu\n\nSHADER = \"@group(0) @binding(0) var<storage, read_write> out: array<f32>; @compute @workgroup_size(1) fn main() {}\"\nfor options in ({'buffers': {'out': {'size': 40_000_000}}}, {'buffers': {'out': {'size': 4}}, 'repeat': 1001}):\n    try:\n        await gpu.run(SHADER, **options)\n    except ValueError as error:\n        print(error)",
      "execution": {
        "when": "live"
      }
    },
    "tensor--paragraph-1": {
      "id": "tensor--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "tensor--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "2×2 矩阵乘法，有 WebGPU 时在 GPU 上计算。"
            }
          ]
        }
      ]
    },
    "tensor--matmul": {
      "id": "tensor--matmul",
      "type": "code",
      "language": "javascript",
      "value": "import { defaultDevice, init, numpy as np } from '@jax-js/jax'\n\nconst devices = await init()\nif (devices.includes('webgpu')) defaultDevice('webgpu')\nconst product = np.matmul(np.array([[1, 2], [3, 4]]), np.array([[5, 6], [7, 8]]))\nconsole.log(defaultDevice(), JSON.stringify(await product.jsAsync()))",
      "execution": {
        "when": "live"
      }
    }
  },
