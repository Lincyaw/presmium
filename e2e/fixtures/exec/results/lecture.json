    "query-results--pm-run-panel-1--source": {
      "id": "query-results--pm-run-panel-1--source",
      "type": "code",
      "language": "python",
      "value": "import sqlite3\nfrom IPython.display import HTML\ndb = sqlite3.connect(':memory:')\ndb.execute('create table teachers (name text, age integer)')\ndb.execute('insert into teachers values (?, ?)', ('Ada', age))\ndisplay(HTML('<table><tr><th>教师</th></tr><tr><td>Ada</td></tr></table>'))\ndb.execute('select name, age from teachers').fetchall()",
      "execution": {
        "when": "both",
        "args": {
          "age": "37"
        }
      }
    },
