    "exec-long--pm-run-panel-1--source": {
      "id": "exec-long--pm-run-panel-1--source",
      "type": "code",
      "language": "python",
      "value": "from collections import Counter\n\n\ndef get_stats(ids):\n    return Counter(zip(ids, ids[1:]))\n\n\ndef merge(ids, pair, new_id):\n    out, i = [], 0\n    while i < len(ids):\n        if i + 1 < len(ids) and (ids[i], ids[i + 1]) == pair:\n            out.append(new_id)\n            i += 2\n        else:\n            out.append(ids[i])\n            i += 1\n    return out\n\n\ndef train(text, vocab_size):\n    ids = list(text.encode(\"utf-8\"))\n    merges = {}\n    for new_id in range(256, vocab_size):\n        stats = get_stats(ids)\n        if not stats:\n            break\n        pair = max(stats, key=stats.get)\n        ids = merge(ids, pair, new_id)\n        merges[pair] = new_id\n    return merges\n\n\ndef encode(text, merges):\n    ids = list(text.encode(\"utf-8\"))\n    while len(ids) >= 2:\n        stats = get_stats(ids)\n        pair = min(stats, key=lambda p: merges.get(p, float(\"inf\")))\n        if pair not in merges:\n            break\n        ids = merge(ids, pair, merges[pair])\n    return ids\n\n\ncorpus = \" \".join([\"low\"] * 5 + [\"lower\"] * 2 + [\"newest\"] * 6 + [\"widest\"] * 3)\nmerges = train(corpus, 266)\nvocab = {i: bytes([i]) for i in range(256)}\nfor (a, b), new_id in merges.items():\n    vocab[new_id] = vocab[a] + vocab[b]\nids = encode(text, merges)\ntokens = [vocab[i].decode(\"utf-8\", errors=\"replace\") for i in ids]\nprint(f\"{tokens} {ids}\")",
      "execution": {
        "when": "both",
        "args": {
          "text": "slowest"
        }
      }
    },
