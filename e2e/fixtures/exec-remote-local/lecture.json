    "remote--where": {
      "id": "remote--where",
      "type": "code",
      "language": "python",
      "value": "import platform\nprint(\"Jupyter\", platform.python_implementation(), 6 * 7)",
      "execution": {
        "when": "both",
        "executor": "presmium.env.lab"
      }
    },
    "session--define": {
      "id": "session--define",
      "type": "code",
      "language": "python",
      "value": "x = 41\nprint(\"defined\")",
      "execution": {
        "when": "live",
        "executor": "presmium.env.lab",
        "session": "browser"
      }
    },
    "session--use": {
      "id": "session--use",
      "type": "code",
