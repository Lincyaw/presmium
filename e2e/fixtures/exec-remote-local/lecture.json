      "value": "print(x + 1)",
      "execution": {
        "when": "live",
        "executor": "presmium.env.lab",
        "session": "browser"
      }
    },
    "rich--display": {
      "id": "rich--display",
      "type": "code",
      "language": "python",
      "value": "from IPython.display import HTML, display\ndisplay(HTML('<strong id=\"jupyter-safe\">rich-42</strong><img src=\"x\" onerror=\"window.__jupyterUnsafe = 1\"><script>window.__jupyterUnsafe = 2</script>'))\nprint(\"rich output\")",
      "execution": {
        "when": "live",
        "executor": "presmium.env.lab"
      }
    },
