  "blocks": {
    "follow-cover--paragraph-1": {
      "id": "follow-cover--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "follow-cover--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "e2e/session.spec.ts 的测试文稿：主讲用完整构建，学习者用学生构建，网页与幻灯片两种形态。"
            }
          ]
        }
      ]
    },
    "follow-cover--paragraph-2": {
      "id": "follow-cover--paragraph-2",
      "type": "text",
      "content": [
        {
          "id": "follow-cover--paragraph-2--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "教师专用的一节在前，所以两种构建给章节的序号不同；学习者按章节 ID 跟随主讲，按块 ID 求得步骤。"
            }
          ]
        }
      ]
    },
    "follow-plan--paragraph-1": {
      "id": "follow-plan--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "follow-plan--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "教师专用：先讲合并规则，再请学生说出下一次合并哪一对。"
            }
          ]
        }
      ]
    },
    "follow-rules--paragraph-1": {
      "id": "follow-rules--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "follow-rules--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "每一轮合并出现次数最多的相邻一对。"
            }
          ]
        }
      ]
    },
    "follow-rules--paragraph-2": {
      "id": "follow-rules--paragraph-2",
      "type": "text",
      "content": [
        {
          "id": "follow-rules--paragraph-2--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "合并规则的讲解。教师专用的一步在前，所以两种构建给这一节之后的步骤的步号也不同。"
            }
          ]
        }
      ]
    },
    "follow-rules--paragraph-3": {
      "id": "follow-rules--paragraph-3",
      "type": "text",
      "content": [
        {
          "id": "follow-rules--paragraph-3--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "教师提示：翻到下一步之前，先请学生猜。"
            }
          ]
        }
      ],
      "audience": [
        "teacher"
      ]
    },
    "follow-rules--paragraph-4": {
      "id": "follow-rules--paragraph-4",
      "type": "text",
      "content": [
        {
          "id": "follow-rules--paragraph-4--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "第一步：数出每一对相邻符号。"
            }
          ]
        }
      ]
    },
    "follow-rules--paragraph-5": {
      "id": "follow-rules--paragraph-5",
      "type": "text",
      "content": [
        {
          "id": "follow-rules--paragraph-5--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "第二步：合并出现最多的一对。"
            }
          ]
        }
      ]
    },
    "follow-ask--pm-question-box-1": {
      "id": "follow-ask--pm-question-box-1",
