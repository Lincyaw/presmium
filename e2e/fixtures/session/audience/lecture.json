          "children": [
            {
              "type": "text",
              "text": "哪里还不清楚？"
            }
          ]
        }
      ]
    },
    "follow-ask--paragraph-1": {
      "id": "follow-ask--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "follow-ask--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "有问题就在这里提。这一节只给学生，两种构建中都有。"
            }
          ]
        }
      ]
    },
    "follow-answers--paragraph-1": {
      "id": "follow-answers--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "follow-answers--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "教师专用：课后整理学生的提问。学生版没有这一节，学习者停在它之前、学生版也有的一节，即只给学生的提问。"
            }
          ]
        }
      ]
