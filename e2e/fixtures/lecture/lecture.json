    "merge--merge-code": {
      "id": "merge--merge-code",
      "type": "code",
      "language": "python",
      "value": "def merge(ids, pair, idx):\n    out = []\n    i = 0\n    while i < len(ids):\n        if ids[i:i + 2] == list(pair):\n            out.append(idx)\n            i += 2\n        else:\n            out.append(ids[i])\n            i += 1\n    return out"
    },
