    "image--png": {
      "id": "image--png",
      "type": "code",
      "language": "python",
      "value": "import struct, zlib\nfrom IPython.display import Image, display\n\ndef chunk(kind, data):\n    return struct.pack('>I', len(data)) + kind + data + struct.pack('>I', zlib.crc32(kind + data))\n\nrows = b''.join(b'\\x00' + b'\\xd0\\x40\\x20' * 8 for _ in range(8))\npng = b'\\x89PNG\\r\\n\\x1a\\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', 8, 8, 8, 2, 0, 0, 0)) + chunk(b'IDAT', zlib.compress(rows)) + chunk(b'IEND', b'')\ndisplay(Image(data=png))",
      "execution": {
        "when": "compile"
      }
    },
