          "children": [
            {
              "type": "text",
              "text": "e2e/perf.spec.ts 的测试文稿：编辑器、流程图与思维导图的幻灯片上，按键到画面仍在 100 毫秒之内。"
            }
          ]
        }
      ]
    },
    "heavy-runner--code-1": {
      "id": "heavy-runner--code-1",
      "type": "code",
      "language": "javascript",
      "value": "const pairs = new Map()\nfor (const [a, b] of [['l', 'o'], ['o', 'w'], ['l', 'o']]) pairs.set(a + b, (pairs.get(a + b) ?? 0) + 1)\nconsole.log([...pairs].sort((x, y) => y[1] - x[1])[0])",
      "execution": {
        "when": "live"
      }
    },
    "heavy-runner--paragraph-1": {
      "id": "heavy-runner--paragraph-1",
