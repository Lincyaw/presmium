        }
      ]
    },
    "heavy-flow--code-1": {
      "id": "heavy-flow--code-1",
      "type": "code",
      "language": "mermaid",
      "value": "flowchart LR\n  A[文本的字节] --> B[统计相邻的对]\n  B --> C[合并次数最多的一对]\n  C --> D{词表够大了吗}\n  D -- 还不够 --> B\n  D -- 够了 --> E[合并规则表]"
