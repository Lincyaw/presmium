  "narrations": {
    "core--paragraph-1--narration": {
      "id": "core--paragraph-1--narration",
      "content": [
        {
          "type": "text",
          "text": "本章演示宿主适配：插件之间通过服务协作，组件的状态由步骤推导，动画尊重减少动态效果的设置，出错的组件只影响自身。组件与三个演示插件来自本目录的测试插件 plugin 与 services。"
        }
      ]
    },
    "core--paragraph-3--narration": {
      "id": "core--paragraph-3--narration",
      "content": [
        {
          "type": "text",
          "text": "fixture.host.provider 提供问候服务，fixture.host.consumer 依赖它，fixture.host.orphan 缺少必需服务而被禁用。启动报告显示在演讲者视图的 Presmium 面板中。"
        }
      ]
    },
    "core--paragraph-5--narration": {
      "id": "core--paragraph-5--narration",
      "content": [
        {
          "type": "text",
          "text": "步进组件有三个标签，占用三步：每一步显示并突出一个标签。"
        }
      ]
    },
    "core--paragraph-6--narration": {
      "id": "core--paragraph-6--narration",
      "content": [
        {
          "type": "text",
          "text": "第一步突出“解析文稿”：步进组件的状态完全由步骤推导。"
        }
      ]
    },
    "core--paragraph-7--narration": {
      "id": "core--paragraph-7--narration",
      "content": [
        {
          "type": "text",
          "text": "第二步突出“启动插件”。"
        }
      ]
    },
    "core--paragraph-8--narration": {
      "id": "core--paragraph-8--narration",
      "content": [
        {
          "type": "text",
          "text": "第三步突出“渲染页面”：直接跳到这一步与从第零步逐步前进到这里，页面完全一致。"
        }
      ]
    },
    "core--paragraph-11--narration": {
      "id": "core--paragraph-11--narration",
      "content": [
        {
          "type": "text",
          "text": "故意抛错的组件显示错误占位，本页其他内容照常渲染，错误同时列在演讲者面板中。"
        }
      ]
    },
    "core-scope--paragraph-1--narration": {
      "id": "core-scope--paragraph-1--narration",
      "content": [
        {
          "type": "text",
          "text": "组件的内部步骤从它所在块出现的那一步算起：同一个步进组件放在第 0 步出现的块中，或者放在第 2 步出现的块中，它的第 k 个内部步骤都显示同样的状态。"
        }
      ]
    },
    "core-scope--paragraph-4--narration": {
      "id": "core-scope--paragraph-4--narration",
      "content": [
        {
          "type": "text",
          "text": "步进组件在第 2 步出现，此时还没有突出任何标签。"
        }
      ]
    },
    "core-scope--paragraph-5--narration": {
      "id": "core-scope--paragraph-5--narration",
      "content": [
        {
          "type": "text",
          "text": "第 3 步是它的第 1 个内部步骤，突出“解析文稿”，与上一页第 1 步的步进组件一致。"
        }
      ]
    },
    "core-scope--paragraph-6--narration": {
      "id": "core-scope--paragraph-6--narration",
      "content": [
        {
          "type": "text",
          "text": "第 4 步突出“启动插件”。"
        }
      ]
    },
    "core-scope--paragraph-7--narration": {
      "id": "core-scope--paragraph-7--narration",
      "content": [
        {
          "type": "text",
          "text": "第 5 步突出“渲染页面”。"
        }
      ]
    }
  },
