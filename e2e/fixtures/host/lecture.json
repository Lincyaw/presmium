    "core-scope--paragraph-1": {
      "id": "core-scope--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "core-scope--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "组件的内部步骤从它所在块出现的那一步算起：同一个步进组件放在第 0 步出现的块中，或者放在第 2 步出现的块中，它的第 k 个内部步骤都显示同样的状态。"
            }
          ]
        }
      ]
    },
