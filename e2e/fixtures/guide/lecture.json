  "blocks": {
    "引导测试文稿--paragraph-1": {
      "id": "引导测试文稿--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "引导测试文稿--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "e2e/guide.spec.ts 的测试文稿：光标、聚光与提示。"
            }
          ]
        }
      ]
    },
    "guide--paragraph-1": {
      "id": "guide--paragraph-1",
      "type": "text",
      "content": [
        {
          "id": "guide--paragraph-1--text-0",
          "type": "paragraph",
          "children": [
            {
              "type": "text",
              "text": "光标、聚光与提示都由步骤驱动：后退或直接跳到某一步，画面与逐步前进到那一步一致。下面是一个模拟的搜索界面，引导指令按 CSS 选择器指向其中的元素。"
            }
          ]
        }
      ]
    },
    "guide--html-1": {
      "id": "guide--html-1",
      "type": "text",
      "content": [
        {
          "id": "guide--html-1--text-0",
          "type": "extension",
          "kind": "presmium.mdast",
          "schemaVersion": 1,
          "data": {
            "node": {
              "type": "html",
              "value": "<div class=\"pm-guide-app\">\n  <input id=\"guide-query\" value=\"presmium\" readonly aria-label=\"关键字\">\n  <button id=\"guide-run\" type=\"button\">搜索</button>\n  <button id=\"guide-help\" type=\"button\" aria-label=\"帮助\">?</button>\n  <div id=\"guide-output\" class=\"pm-guide-app__output\"><p>找到 3 条结果</p></div>\n</div>"
            }
          },
          "fallback": [
            {
              "id": "guide--html-1--text-0-fallback",
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "<div class=\"pm-guide-app\">\n  <input id=\"guide-query\" value=\"presmium\" readonly aria-label=\"关键字\">\n  <button id=\"guide-run\" type=\"button\">搜索</button>\n  <button id=\"guide-help\" type=\"button\" aria-label=\"帮助\">?</button>\n  <div id=\"guide-output\" class=\"pm-guide-app__output\"><p>找到 3 条结果</p></div>\n</div>"
                }
              ]
            }
          ]
        }
      ]
    },
    "guide--html-2": {
      "id": "guide--html-2",
      "type": "text",
      "content": [
        {
          "id": "guide--html-2--text-0",
          "type": "extension",
          "kind": "presmium.mdast",
          "schemaVersion": 1,
          "data": {
            "node": {
              "type": "html",
              "value": "<style>\n.pm-guide-app {\n  display: grid;\n  grid-template-columns: 1fr auto auto;\n  gap: 0.5rem;\n  margin-top: 1.5rem;\n  padding: 1rem;\n  border: 1px solid rgb(125 125 125 / 0.4);\n  border-radius: 0.5rem;\n}\n.pm-guide-app input {\n  min-width: 0;\n  padding: 0.25rem 0.5rem;\n  border: 1px solid rgb(125 125 125 / 0.4);\n  border-radius: 0.25rem;\n  background: transparent;\n}\n.pm-guide-app button {\n  padding: 0.25rem 0.75rem;\n  border-radius: 0.25rem;\n  background: #0369a1;\n  color: #fff;\n}\n.pm-guide-app__output {\n  grid-column: 1 / -1;\n  min-height: 6rem;\n  padding: 0.5rem 0.75rem;\n  border-radius: 0.25rem;\n  background: rgb(125 125 125 / 0.1);\n}\n/* The results show once the cursor has clicked the search button. */\n.pm-guide-app__output p {\n  visibility: hidden;\n}\n#guide-run[data-pm-cursor='click'] ~ .pm-guide-app__output p {\n  visibility: visible;\n}\n</style>"
            }
          },
          "fallback": [
            {
              "id": "guide--html-2--text-0-fallback",
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "<style>\n.pm-guide-app {\n  display: grid;\n  grid-template-columns: 1fr auto auto;\n  gap: 0.5rem;\n  margin-top: 1.5rem;\n  padding: 1rem;\n  border: 1px solid rgb(125 125 125 / 0.4);\n  border-radius: 0.5rem;\n}\n.pm-guide-app input {\n  min-width: 0;\n  padding: 0.25rem 0.5rem;\n  border: 1px solid rgb(125 125 125 / 0.4);\n  border-radius: 0.25rem;\n  background: transparent;\n}\n.pm-guide-app button {\n  padding: 0.25rem 0.75rem;\n  border-radius: 0.25rem;\n  background: #0369a1;\n  color: #fff;\n}\n.pm-guide-app__output {\n  grid-column: 1 / -1;\n  min-height: 6rem;\n  padding: 0.5rem 0.75rem;\n  border-radius: 0.25rem;\n  background: rgb(125 125 125 / 0.1);\n}\n/* The results show once the cursor has clicked the search button. */\n.pm-guide-app__output p {\n  visibility: hidden;\n}\n#guide-run[data-pm-cursor='click'] ~ .pm-guide-app__output p {\n  visibility: visible;\n}\n</style>"
                }
              ]
            }
          ]
        }
      ]
    },
