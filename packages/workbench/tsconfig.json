{
  // The workbench's React panels and the client part of @lincyaw/dsh, type-checked together (`tsc -p packages/workbench`);
  // the repository's tsconfig.json takes `.ts` only.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["src/**/*", "../dsh/src/client/**/*", "../design/src/**/*.ts"]
}
