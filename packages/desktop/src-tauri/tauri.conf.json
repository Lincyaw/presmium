{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Presmium Studio",
  "mainBinaryName": "presmium-desktop",
  "version": "0.1.0",
  "identifier": "io.github.lincyaw.presmium",
  "build": {
    "frontendDist": "../build/ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Presmium Studio",
    "longDescription": "Edit, compile and present Presmium documents: web pages, slides and narrated video.",
    "copyright": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/presmium-node"],
    "resources": {
      "../build/runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
