{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Presmium Studio",
  "mainBinaryName": "presmium-desktop",
  "version": "../../presmium/package.json",
  "identifier": "io.github.lincyaw.presmium",
  "build": {
    "frontendDist": "../build/ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Education",
    "shortDescription": "Presmium Studio",
    "longDescription": "Edit, compile and present Presmium documents: web pages, slides and narrated video.",
    "copyright": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/presmium-node"
    ],
    "resources": {
      "../build/runtime/": "runtime/"
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "compression": {
          "type": "zstd",
          "level": 19
        }
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDODQzNzQwRjdGQ0E3RTgKUldUb3AvejNRRGVFL0dPVGhEL3JxT3RRcUJ5akdjZENZY3ArNE1IMlVLb0pDUFI5dEFXWjF1UDEK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/Lincyaw/presmium/releases/download/desktop-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
