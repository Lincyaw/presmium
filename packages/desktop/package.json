{
  "name": "presmium-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Presmium Studio as a desktop app (Tauri 2): Windows, macOS and Linux, with its own Node runtime",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "prepare:desktop": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs && tauri dev",
    "build": "node scripts/prepare.mjs && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lincyaw/presmium": "workspace:*"
  },
  "devDependencies": {
    "@lincyaw/design": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "esbuild": "0.25.12"
  },
  "presmium": {
    "generated": [
      "build",
      "src-tauri"
    ]
  }
}
