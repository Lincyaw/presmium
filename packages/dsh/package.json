{
  "name": "@presmium/dsh",
  "version": "0.1.0",
  "description": "Presmium's bundle for DeepSeek Harness: the workbench of presmium studio, its host side (Presmium's tools, approvals, document context, skills and routes) and its client side (the root layout and the workbench's panels, precompiled) (experimental)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git",
    "directory": "packages/dsh"
  },
  "homepage": "https://github.com/Lincyaw/presmium/tree/main/packages/dsh#readme",
  "bugs": "https://github.com/Lincyaw/presmium/issues",
  "keywords": [
    "presmium",
    "dsh",
    "deepseek-harness",
    "bundle"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-alpha.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./rows/workbench.mjs",
    "./client": "./build/dist/client.js",
    "./service": "./rows/service.mjs",
    "./workspaces": "./rows/workspaces.mjs",
    "./tools": "./rows/tools.mjs",
    "./policy": "./rows/policy.mjs",
    "./context": "./rows/context.mjs",
    "./skills": "./rows/skills.mjs",
    "./routes": "./rows/routes.mjs",
    "./turns": "./rows/turns.mjs",
    "./launch": "./src/node/launch.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "rows",
    "build",
    "src",
    "skills",
    "cordis.patch.yml",
    "web.patch.yml",
    "profile.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "presmium": {
    "skills": [
      "presmium-author",
      "presmium-present"
    ],
    "generated": [
      "skills",
      "build/dist"
    ]
  },
  "scripts": {
    "prepack": "node build/client.mjs && node scripts/copy-skills.mjs"
  },
  "dependencies": {
    "@presmium/cli": "workspace:*",
    "@presmium/kernel": "workspace:*",
    "@presmium/mcp": "workspace:*",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.4",
    "@presmium/design": "workspace:*",
    "@presmium/workbench": "workspace:*",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "^4.14.5"
  }
}
