{
  "name": "@lincyaw/dsh",
  "version": "0.1.0",
  "description": "Presmium's bundle for DeepSeek Harness: the workbench of presmium studio, its host side (Presmium's tools, approvals, document context, skills and routes) and its client side (the root layout and the workbench's panels, precompiled) (experimental)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git",
    "directory": "packages/dsh"
  },
  "homepage": "https://github.com/Lincyaw/presmium/tree/main/packages/dsh#readme",
  "bugs": "https://github.com/Lincyaw/presmium/issues",
  "keywords": [
    "presmium",
    "dsh",
    "deepseek-harness",
    "bundle"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-alpha.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./entries/workbench.mjs",
    "./client": "./build/dist/client.js",
    "./service": "./entries/service.mjs",
    "./workspaces": "./entries/workspaces.mjs",
    "./tools": "./entries/tools.mjs",
    "./policy": "./entries/policy.mjs",
    "./context": "./entries/context.mjs",
    "./skills": "./entries/skills.mjs",
    "./routes": "./entries/routes.mjs",
    "./turns": "./entries/turns.mjs",
    "./telemetry": "./entries/telemetry.mjs",
    "./events": {
      "types": "./src/node/workspace-events.ts",
      "default": "./entries/events.mjs"
    },
    "./workspace-events": "./src/workspace-events.ts",
    "./launch": "./src/node/launch.ts",
    "./testing": "./src/node/fake-model.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "entries",
    "build",
    "src",
    "cordis.patch.yml",
    "web.patch.yml",
    "profile.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "presmium": {
    "skills": [
      "presmium-animate",
      "presmium-author",
      "presmium-present",
      "presmium-develop"
    ],
    "generated": [
      "build/dist"
    ]
  },
  "scripts": {
    "prepack": "node build/client.mjs"
  },
  "dependencies": {
    "@lincyaw/cli": "workspace:*",
    "@lincyaw/kernel": "workspace:*",
    "@lincyaw/mcp": "workspace:*",
    "eventsource": "3.0.7",
    "jiti": "^2.7.0",
    "ws": "8.22.0",
    "zod": "4.4.3",
    "@lincyaw/skills": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.4",
    "@lincyaw/design": "workspace:*",
    "@lincyaw/workbench": "workspace:*",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/ws": "^8.18.2",
    "esbuild": "0.25.12",
    "partysocket": "1.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "^4.14.5"
  }
}
