{
  "name": "presmium-vscode",
  "displayName": "%displayName%",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "publisher": "presmium",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git",
    "directory": "packages/vscode"
  },
  "description": "%description%",
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.142.0"
  },
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/lecture.json"
  ],
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "**/lecture.json",
        "url": "./dist/lecture.schema.json"
      }
    ],
    "commands": [
      {
        "command": "presmium.openPreview",
        "title": "%command.openPreview%",
        "category": "%category%",
        "icon": "$(open-preview)"
      },
      {
        "command": "presmium.openStudio",
        "title": "%command.openStudio%",
        "category": "%category%",
        "icon": "$(edit)"
      },
      {
        "command": "presmium.present",
        "title": "%command.present%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "presmium.stopStudio",
        "title": "%command.stopStudio%",
        "category": "%category%"
      },
      {
        "command": "presmium.installSkills",
        "title": "%command.installSkills%",
        "category": "%category%",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "presmium.openPreview",
          "when": "resourceScheme == file && resourceFilename == lecture.json && editorLangId == json",
          "group": "navigation"
        },
        {
          "command": "presmium.openStudio",
          "when": "resourceScheme == file && resourceFilename == lecture.json && editorLangId == json",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "presmium.openStudio",
          "when": "resourceScheme == file && resourceFilename == lecture.json",
          "group": "navigation"
        },
        {
          "command": "presmium.installSkills",
          "when": "resourceScheme == file && (explorerResourceIsFolder || resourceFilename == lecture.json)",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "presmium.openPreview",
          "when": "resourceScheme == file && resourceFilename == lecture.json && editorLangId == json"
        },
        {
          "command": "presmium.present",
          "when": "resourceScheme == file && resourceFilename == lecture.json && editorLangId == json"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "presmium.server.runtime": {
          "type": "string",
          "default": "node",
          "description": "%configuration.server.runtime%",
          "scope": "machine"
        },
        "presmium.server.path": {
          "type": "string",
          "default": "",
          "description": "%configuration.server.path%",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:vsix": "node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@lincyaw/kernel": "workspace:*",
    "@lincyaw/language-server": "workspace:*",
    "vscode-languageclient": "10.1.2",
    "@lincyaw/studio": "workspace:*",
    "@lincyaw/skills": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.91.0",
    "@types/yauzl": "2.10.3",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.21.5",
    "vscode-jsonrpc": "9.0.3",
    "yauzl": "3.4.0"
  },
  "files": [
    "dist/extension.cjs",
    "dist/lecture.schema.json",
    "l10n",
    "package.nls*.json",
    "README.md",
    "LICENSE"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": false
  }
}
