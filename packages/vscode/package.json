{
  "name": "presmium-vscode",
  "displayName": "%displayName%",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "publisher": "presmium",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git",
    "directory": "packages/vscode"
  },
  "description": "%description%",
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "presmium.openPreview",
        "title": "%command.openPreview%",
        "category": "%category%",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "presmium.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "presmium.server.runtime": {
          "type": "string",
          "default": "node",
          "description": "%configuration.server.runtime%"
        },
        "presmium.server.path": {
          "type": "string",
          "default": "",
          "description": "%configuration.server.path%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@presmium/kernel": "workspace:*",
    "@presmium/language-server": "workspace:*",
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/vscode": "1.91.0",
    "esbuild": "0.21.5"
  }
}
