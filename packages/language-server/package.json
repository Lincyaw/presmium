{
  "name": "@lincyaw/language-server",
  "version": "1.0.0-rc.0",
  "description": "Language server for canonical lecture.json documents: validation, entity navigation, code anchors and preview sync",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git",
    "directory": "packages/language-server"
  },
  "homepage": "https://github.com/Lincyaw/presmium/tree/main/packages/language-server#readme",
  "bugs": "https://github.com/Lincyaw/presmium/issues",
  "keywords": [
    "presmium",
    "lsp",
    "language-server"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "presmium-language-server": "./bin/presmium-language-server.mjs"
  },
  "exports": {
    "./domain": "./src/domain/index.ts",
    "./protocol": "./src/domain/protocol.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@lincyaw/cli": "workspace:*",
    "@lincyaw/compiler": "workspace:*",
    "@lincyaw/host": "workspace:*",
    "@lincyaw/kernel": "workspace:*",
    "@lincyaw/viewer": "workspace:*",
    "@lincyaw/web": "workspace:*",
    "jiti": "^2.7.0",
    "jsonc-parser": "3.3.1",
    "vscode-languageserver": "10.1.2",
    "vscode-languageserver-textdocument": "1.0.15"
  }
}
