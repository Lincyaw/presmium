{
  "name": "@presmium/language-server",
  "version": "1.0.0-rc.0",
  "description": "Language server for Presmium documents: diagnostics, anchor definitions and hovers, completion and preview sync",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/presmium/presmium.git",
    "directory": "packages/language-server"
  },
  "homepage": "https://github.com/presmium/presmium/tree/main/packages/language-server#readme",
  "bugs": "https://github.com/presmium/presmium/issues",
  "keywords": [
    "presmium",
    "lsp",
    "language-server"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "presmium-language-server": "./bin/presmium-language-server.mjs"
  },
  "exports": {
    "./domain": "./src/domain/index.ts",
    "./protocol": "./src/domain/protocol.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@presmium/cli": "workspace:*",
    "@presmium/compiler": "workspace:*",
    "@presmium/kernel": "workspace:*",
    "@presmium/web": "workspace:*",
    "jiti": "^2.7.0",
    "vscode-languageserver": "10.1.2",
    "vscode-languageserver-textdocument": "1.0.15"
  }
}
