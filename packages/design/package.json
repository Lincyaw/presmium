{
  "name": "@lincyaw/design",
  "version": "1.0.0-rc.0",
  "description": "Presmium's design system, shared by its outputs and its workbench: the tokens, the classes of the shared components, the fonts and the line icons, bound to no framework",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git",
    "directory": "packages/design"
  },
  "homepage": "https://github.com/Lincyaw/presmium/tree/main/packages/design#readme",
  "bugs": "https://github.com/Lincyaw/presmium/issues",
  "keywords": [
    "presmium",
    "design-system",
    "design-tokens"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./mascot": "./src/assets/mascot.ts",
    "./design.css": "./src/design.css",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./fonts.css": "./src/fonts.css",
    "./block-preview.css": "./src/block-preview.css"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "lucide": "1.59.0"
  },
  "scripts": {
    "mascot": "node tools/mascot/build.ts"
  }
}
