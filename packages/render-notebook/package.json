{
  "name": "@presmium/render-notebook",
  "version": "1.0.0-rc.0",
  "description": "Presmium's notebook renderer: writes the IR as a Jupyter notebook (nbformat 4)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/presmium/presmium.git",
    "directory": "packages/render-notebook"
  },
  "homepage": "https://github.com/presmium/presmium/tree/main/packages/render-notebook#readme",
  "bugs": "https://github.com/presmium/presmium/issues",
  "keywords": [
    "presmium",
    "jupyter",
    "notebook",
    "renderer"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
