{
  "name": "@lincyaw/web",
  "version": "1.0.0-rc.14",
  "description": "Presmium's web renderer: one prebuilt viewer that shows the web form in the workbench, in a dev server and as a built site, with search and form switching",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/Lincyaw/presmium/tree/main/packages/web#readme",
  "bugs": "https://github.com/Lincyaw/presmium/issues",
  "keywords": [
    "presmium",
    "renderer"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./domain": "./src/domain/index.ts",
    "./presmium": "./src/node/presmium.ts",
    "./site": "./src/site/index.ts",
    "./slides": "./src/node/slides.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@lincyaw/design": "workspace:*",
    "escape-html": "1.0.3",
    "http-proxy-3": "2.0.1",
    "katex": "0.18.10",
    "launch-editor": "2.14.1",
    "minisearch": "7.2.0",
    "p-limit": "7.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "send": "1.2.1",
    "sharp": "0.35.5",
    "sitemap": "9.0.1",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "@lincyaw/host": "workspace:^",
    "@lincyaw/kernel": "workspace:^",
    "@lincyaw/viewer": "workspace:^"
  },
  "devDependencies": {
    "@lincyaw/cli": "workspace:*",
    "@lincyaw/host": "workspace:*",
    "@lincyaw/kernel": "workspace:*",
    "@lincyaw/viewer": "workspace:*",
    "@types/escape-html": "1.0.4",
    "@types/send": "^1.2.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7"
  }
}
