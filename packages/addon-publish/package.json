{
  "name": "@presmium/slidev-addon-publish",
  "version": "1.0.0-rc.0",
  "description": "Presmium plugin: publishing: offline sites, high contrast, PDF and image export (presmium-export), visual diffs (presmium-diff)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git",
    "directory": "packages/addon-publish"
  },
  "homepage": "https://github.com/Lincyaw/presmium/tree/main/packages/addon-publish#readme",
  "bugs": "https://github.com/Lincyaw/presmium/issues",
  "keywords": [
    "slidev-addon",
    "slidev",
    "presmium"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "presmium-diff": "./bin/presmium-diff.mjs",
    "presmium-export": "./bin/presmium-export.mjs"
  },
  "exports": {
    "./domain": "./src/domain/index.ts",
    "./client": "./src/client/index.ts",
    "./presmium": "./src/node/presmium.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "components",
    "index.html",
    "setup",
    "src",
    "style.css"
  ],
  "slidev": {},
  "dependencies": {
    "@slidev/types": "53.0.0",
    "jiti": "^2.7.0",
    "pdf-lib": "^1.17.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-remote-assets": "^2.1.0",
    "vite-plugin-webfont-dl": "^3.13.1",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "@presmium/compiler": "workspace:^",
    "@presmium/host": "workspace:^",
    "@presmium/kernel": "workspace:^"
  },
  "devDependencies": {
    "@presmium/cli": "workspace:*",
    "@presmium/compiler": "workspace:*",
    "@presmium/host": "workspace:*",
    "@presmium/kernel": "workspace:*",
    "@presmium/render-slides": "workspace:*",
    "@presmium/web": "workspace:*",
    "@slidev/cli": "53.0.0",
    "@slidev/client": "53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@types/pngjs": "^6.0.5",
    "pdfjs-dist": "5.7.284",
    "playwright-chromium": "1.64.1"
  }
}
