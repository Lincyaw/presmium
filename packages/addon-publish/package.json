{
  "name": "@lincyaw/addon-publish",
  "version": "1.0.0-rc.6",
  "description": "Presmium plugin: publishing: offline sites, high contrast, PDF and image export (presmium-export), visual diffs (presmium-diff)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git",
    "directory": "packages/addon-publish"
  },
  "homepage": "https://github.com/Lincyaw/presmium/tree/main/packages/addon-publish#readme",
  "bugs": "https://github.com/Lincyaw/presmium/issues",
  "keywords": [
    "presmium"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "presmium-diff": "./bin/presmium-diff.mjs",
    "presmium-export": "./bin/presmium-export.mjs"
  },
  "exports": {
    "./domain": "./src/domain/index.ts",
    "./client": "./src/client/index.ts",
    "./presmium": "./src/node/presmium.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "components",
    "src"
  ],
  "dependencies": {
    "jiti": "^2.7.0",
    "pdf-lib": "^1.17.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "@lincyaw/compiler": "workspace:^",
    "@lincyaw/host": "workspace:^",
    "@lincyaw/kernel": "workspace:^",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@lincyaw/cli": "workspace:*",
    "@lincyaw/compiler": "workspace:*",
    "@lincyaw/host": "workspace:*",
    "@lincyaw/kernel": "workspace:*",
    "@lincyaw/render-slides": "workspace:*",
    "@lincyaw/web": "workspace:*",
    "@types/pngjs": "^6.0.5",
    "pdfjs-dist": "5.7.284",
    "playwright-chromium": "1.64.1",
    "react": "18.3.1",
    "@types/react": "18.3.28"
  }
}
