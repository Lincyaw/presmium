{
  "name": "create-presmium",
  "version": "1.0.0-rc.13",
  "description": "presmium new, or pnpm create presmium: a new Presmium lecture, workspace or plugin",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git",
    "directory": "packages/create-presmium"
  },
  "homepage": "https://github.com/Lincyaw/presmium/tree/main/packages/create-presmium#readme",
  "bugs": "https://github.com/Lincyaw/presmium/issues",
  "keywords": [
    "presmium",
    "create",
    "template",
    "document-ir",
    "slides"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-presmium": "./bin/create-presmium.mjs"
  },
  "exports": {
    ".": "./src/cli.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "templates"
  ],
  "scripts": {
    "prepack": "node scripts/templates.ts",
    "templates": "node scripts/templates.ts"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "@lincyaw/kernel": "workspace:*"
  },
  "devDependencies": {
    "@lincyaw/cli": "workspace:*"
  },
  "presmium": {
    "generated": [
      "templates"
    ]
  }
}
