{
  "schemaVersion": 1,
  "id": "document-template",
  "metadata": {
    "title": "{{title}}",
    "lang": "zh-CN",
    "plugins": [
      "@lincyaw/addon-lecture",
      "@lincyaw/addon-speech"
    ],
    "renderers": {
      "web": {},
      "slides": {},
      "notebook": {},
      "lecture": {}
    }
  },
  "sectionOrder": [
    "intro"
  ],
  "sections": {
    "intro": {
      "id": "intro",
      "title": "{{title}}",
      "children": [
        "intro-body"
      ],
      "stepOrder": [
        "intro-step"
      ],
      "layout": {
        "type": "stack"
      }
    }
  },
  "blocks": {
    "intro-body": {
      "id": "intro-body",
      "type": "text",
      "content": [
        {
          "id": "intro-paragraph",
          "type": "paragraph",
          "children": []
        }
      ]
    }
  },
  "steps": {
    "intro-step": {
      "id": "intro-step",
      "sectionId": "intro",
      "visuals": [
        {
          "blockId": "intro-body",
          "visible": true
        }
      ],
      "narrationIds": []
    }
  },
  "narrations": {},
  "assets": {},
  "definitions": {},
  "production": {
    "defaults": {},
    "stepOverrides": {
      "intro-step": {
        "minimumHoldMs": 4000,
        "trailingPauseMs": 500
      }
    },
    "mediaClips": []
  }
}
