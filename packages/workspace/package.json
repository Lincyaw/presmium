{
  "name": "@lincyaw/workspace",
  "version": "1.0.0-rc.0",
  "description": "Presmium's workspace service (presmium serve): documents, their history, reviews and the workspace site",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git",
    "directory": "packages/workspace"
  },
  "homepage": "https://github.com/Lincyaw/presmium/tree/main/packages/workspace#readme",
