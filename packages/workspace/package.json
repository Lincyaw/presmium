{
  "name": "@presmium/workspace",
  "version": "1.0.0-rc.0",
  "description": "Presmium's workspace service (presmium serve): documents, editing in the browser, revision history and the workspace site",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lincyaw/presmium.git",
    "directory": "packages/workspace"
  },
  "homepage": "https://github.com/Lincyaw/presmium/tree/main/packages/workspace#readme",
  "bugs": "https://github.com/Lincyaw/presmium/issues",
  "keywords": [
    "presmium",
    "workspace",
    "editor"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts",
    "./client": "./src/client/plugin.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "templates",
    "vite.config.ts"
  ],
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@presmium/compiler": "workspace:*",
    "@presmium/host": "workspace:*",
    "@presmium/kernel": "workspace:*",
    "@presmium/server": "workspace:*",
    "node-diff3": "3.2.1",
    "vue": "^3.5.42",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@presmium/viewer": "workspace:*"
  }
}
