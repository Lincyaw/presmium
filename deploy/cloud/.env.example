# Copy to .env, protect with chmod 600, and replace every empty secret.
CLOUD_COMPOSE_PROJECT=presmium-cloud
CLOUD_IMAGE_TAG=0.1.0
CLOUD_INSTANCE_ID=presmium-cloud

# The console, sign-in and shared documents have origins of their own. Every Studio gets two hosts under
# CLOUD_STUDIO_HOST (s-<id>.studio.example.net and p-<id>.studio.example.net): point *.studio.example.net at the
# server in DNS. Certificates are issued per host on first use (Let's Encrypt rate limits apply).
CLOUD_APP_HOST=app.example.com
CLOUD_AUTH_HOST=auth.example.com
CLOUD_CONTENT_HOST=content.example.net
CLOUD_STUDIO_HOST=studio.example.net
CLOUD_PUBLIC_URL=https://app.example.com
CLOUD_AUTH_URL=https://auth.example.com
CLOUD_CONTENT_URL=https://content.example.net
CLOUD_STUDIO_URL=https://studio.example.net
CLOUD_OIDC_ISSUER=https://auth.example.com/realms/presmium
CLOUD_OIDC_ISSUER_INTERNAL_URL=http://keycloak:8080/realms/presmium
CLOUD_ACME_EMAIL=operator@example.com
CLOUD_BIND_ADDRESS=0.0.0.0
CLOUD_HTTP_PORT=80
CLOUD_HTTPS_PORT=443
CLOUD_LOOPBACK_PORT=18787

# Generate each secret independently: openssl rand -hex 32
CLOUD_DATABASE_PASSWORD=
CLOUD_KEYCLOAK_DATABASE_PASSWORD=
CLOUD_KEYCLOAK_ADMIN=operator
CLOUD_KEYCLOAK_ADMIN_PASSWORD=
CLOUD_OIDC_CLIENT_ID=presmium-cloud
CLOUD_OIDC_CLIENT_SECRET=
CLOUD_OIDC_AUDIENCE=presmium-api
CLOUD_CREDENTIAL_KEY=

# Host XFS project-quota pool created by storage/provision.sh, one slot per Studio (slot size = diskBytes in
# studio-profile.json). CLOUD_STORAGE_UNENFORCED=true uses plain directories instead and is accepted only with
# compose.loopback.yaml.
CLOUD_RUNTIME_STORAGE_HOST=/srv/presmium-runtime
CLOUD_STORAGE_UNENFORCED=false

# Isolated self-hosted S3 example. Replace with external S3 in compose overrides if desired.
CLOUD_S3_BUCKET=presmium
CLOUD_S3_ENDPOINT=http://object-store:9000
CLOUD_S3_REGION=us-east-1
CLOUD_S3_ACCESS_KEY_ID=presmium-storage
CLOUD_S3_SECRET_ACCESS_KEY=

# Production self-registration verifies email. Configure SMTP before accepting registrations.
# Realm import applies these settings on its first creation only.
CLOUD_KEYCLOAK_VERIFY_EMAIL=true
CLOUD_SMTP_HOST=
CLOUD_SMTP_PORT=587
CLOUD_SMTP_FROM=
CLOUD_SMTP_AUTH=true
CLOUD_SMTP_USER=
CLOUD_SMTP_PASSWORD=
CLOUD_SMTP_STARTTLS=true
CLOUD_SMTP_SSL=false
