{
	email {$CLOUD_ACME_EMAIL}
	admin off
}

{$CLOUD_APP_HOST} {
	encode zstd gzip
	header X-Content-Type-Options nosniff
	header Referrer-Policy same-origin
	reverse_proxy api:8787
}

{$CLOUD_AUTH_HOST} {
	encode zstd gzip
	header Referrer-Policy no-referrer
	reverse_proxy keycloak:8080
}

{$CLOUD_CONTENT_HOST} {
	header X-Content-Type-Options nosniff
	header Referrer-Policy no-referrer
	@content path /p/*
	handle @content {
		reverse_proxy api:8787 {
			header_up -Cookie
			header_up -Authorization
			header_down -Set-Cookie
		}
	}
	handle {
		respond 404
	}
}

# JupyterHub: sign-in to Studio and every user's Studio below /user/<name>/.
{$CLOUD_HUB_HOST} {
	@studioAssets path_regexp ^/user/[^/]+/(preview/__app/(v|d)/|studio/(plugins/$|assets/))
	encode @studioAssets zstd gzip
	reverse_proxy hub:8000 {
		flush_interval -1
	}
}
