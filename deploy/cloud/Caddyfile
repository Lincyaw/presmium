{
	email {$CLOUD_ACME_EMAIL}
	admin off
	# Each Studio's two hosts get their certificate on first use, for Studios that exist only.
	on_demand_tls {
		ask http://api:8787/internal/tls
	}
}

{$CLOUD_APP_HOST} {
	encode zstd gzip
	header X-Content-Type-Options nosniff
	header Referrer-Policy same-origin
	reverse_proxy api:8787
}

{$CLOUD_AUTH_HOST} {
	encode zstd gzip
	header Referrer-Policy no-referrer
	reverse_proxy keycloak:8080
}

{$CLOUD_CONTENT_HOST} {
	header X-Content-Type-Options nosniff
	header Referrer-Policy no-referrer
	@content path /p/*
	handle @content {
		reverse_proxy api:8787 {
			header_up -Cookie
			header_up -Authorization
			header_down -Set-Cookie
		}
	}
	handle {
		respond 404
	}
}

# s-<id> is a user's Studio and p-<id> its previews. The console checks every request and keeps Host.
*.{$CLOUD_STUDIO_HOST} {
	tls {
		on_demand
	}
	reverse_proxy api:8787 {
		flush_interval -1
	}
}
