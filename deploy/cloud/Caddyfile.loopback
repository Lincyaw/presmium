# Loopback validation over plain HTTP: the same routes as the Caddyfile, without certificates.
{
	admin off
	auto_https off
}

{$CLOUD_APP_HOST} {
	reverse_proxy api:8787
}

{$CLOUD_AUTH_HOST} {
	reverse_proxy keycloak:8080
}

{$CLOUD_CONTENT_HOST} {
	@content path /p/*
	handle @content {
		reverse_proxy api:8787 {
			header_up -Cookie
			header_up -Authorization
			header_down -Set-Cookie
		}
	}
	handle {
		respond 404
	}
}

http://*.{$CLOUD_STUDIO_HOST} {
	reverse_proxy api:8787 {
		flush_interval -1
	}
}
